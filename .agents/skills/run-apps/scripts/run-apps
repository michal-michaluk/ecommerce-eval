#!/usr/bin/env python3
"""run-apps — the shop-wide local k3s environment, with one namespace per service in it.

Three services live in it: `catalog` (realm `catalog`, http://127.0.0.1:8080), `fulfillment`
(realm `iot`, http://127.0.0.1:8081) and `shopping` (realm `shopping`, http://127.0.0.1:8082 —
scaffolded, its realm document does not exist yet). The cluster (`shop-k3s`, k3s in a privileged podman
container), the Postgres instance (`postgresql`) and one Keycloak holding every realm are
shop-wide: one server, one superuser secret, one logical database per service (from `databases.txt`
in manifests/infra/postgres.yaml). The image built by Jib, the namespace, the Deployment, one host
port-forward and one realm stay per service.

Every command is idempotent and bounded: no `kubectl logs -f`, no `kubectl get -w`, every wait carries
a timeout and on timeout prints the state it timed out on. Managed host-side processes (the
port-forwards) are recorded in .agents/runtime/processes.json.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import re
import signal
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
WORKSPACE = SKILL_DIR.parents[2]
SERVICES = WORKSPACE / "services"
MANIFESTS = SKILL_DIR / "manifests"
RUNTIME = WORKSPACE / ".agents/runtime"
STATE_FILE = RUNTIME / "processes.json"
KUBECONFIG = RUNTIME / "kubeconfig-shop.yaml"
LOG_DIR = RUNTIME / "logs"
TOKENS_ENV = RUNTIME / "tokens.env"
LEGACY_TOKEN_FILES = (RUNTIME / "catalog-tokens.env",)

CLUSTER = "shop-k3s"
# Before the shop-wide rename the cluster was per service. A machine that still carries the old one
# must never end up with two clusters: `deploy` and `stop` reuse this list.
LEGACY_CLUSTERS = ("catalog-k3s",)
LEGACY_KUBECONFIGS = (RUNTIME / "kubeconfig-catalog.yaml",)
STATE_VERSION = 2
# The shared infra lives in one namespace: postgresql, kafka, keycloak.
NAMESPACE = "catalog"
POSTGRES = "postgresql"
KEYCLOAK_SERVICE = "catalog-keycloak"
KEYCLOAK_REALMS = "keycloak-realm"
K3S_IMAGE = "docker.io/rancher/k3s:v1.35.5-k3s1"
API_PORT = 6443
KEYCLOAK_PORT = 18081
INFRA_DEPLOYMENTS = (POSTGRES, "kafka", "keycloak")

T_NODE_READY = 180
T_ROLLOUT = 420
T_HEALTH = 180
T_FORWARD = 90
T_BUILD = 1800
T_HURL = 1800


class Fail(Exception):
    """A step that cannot continue: the message is the diagnostic the operator needs."""


@dataclass(frozen=True)
class App:
    """One tenant of the shop-wide environment: its own namespace, image, forward row and realm."""

    name: str
    port: int
    realm: str
    suite: str
    users: tuple[tuple[str, str], ...]
    variables: tuple[tuple[str, str], ...]
    realm_documents: tuple[Path, ...]
    warmup: tuple[str, str]
    dates: bool = False
    service_port: int = 80

    @property
    def namespace(self) -> str:
        return self.name

    @property
    def deployment(self) -> str:
        return self.name

    @property
    def service(self) -> str:
        return self.name

    @property
    def image(self) -> str:
        return f"{self.name}:latest"

    @property
    def directory(self) -> Path:
        return SERVICES / self.name

    @property
    def tar(self) -> Path:
        return self.directory / "build/jib-image.tar"

    @property
    def manifest(self) -> Path:
        return MANIFESTS / self.name

    @property
    def forward(self) -> str:
        return f"{self.name}-app"

    @property
    def url(self) -> str:
        return f"http://127.0.0.1:{self.port}"

    @property
    def health_url(self) -> str:
        return f"{self.url}/actuator/health"

    def realm_document(self) -> Path:
        for candidate in self.realm_documents:
            if candidate.exists():
                return candidate
        raise Fail(
            f"no realm document for {self.name}: tried "
            + ", ".join(str(candidate.relative_to(WORKSPACE)) for candidate in self.realm_documents)
        )

    def realm_document_paths(self) -> str:
        return ", ".join(str(candidate.relative_to(WORKSPACE)) for candidate in self.realm_documents)

    @property
    def configured(self) -> bool:
        """A service is configured once its realm document exists. Until then its realm is never
        imported, no token of it can be minted, and no verdict may depend on it."""
        return any(candidate.exists() for candidate in self.realm_documents)


CATALOG = App(
    name="catalog",
    port=8080,
    realm="catalog",
    suite="e2e/healthcheck.hurl",
    users=(
        ("author", "catalog-author-client"),
        ("reviewer", "catalog-reviewer-client"),
        ("photographer", "catalog-photographer-client"),
        ("sales", "catalog-sales-client"),
    ),
    variables=(
        ("author_token", "author"),
        ("reviewer_token", "reviewer"),
        ("photographer_token", "photographer"),
        ("sales_token", "sales"),
    ),
    # The service's own document wins; `main` does not carry it (it is on feat/catalog-domain-model),
    # so the skill vendors the same document and the deploy works on either branch.
    realm_documents=(
        SERVICES / "catalog/src/test/resources/catalog-realm.json",
        MANIFESTS / "realms/catalog-realm.json",
    ),
    warmup=("/actuator/info", "author"),
    dates=True,
)

FULFILLMENT = App(
    name="fulfillment",
    port=8081,
    realm="iot",
    suite="e2e/fulfillment-api.hurl",
    users=(
        ("employee", "fulfillment-employee-client"),
        ("other-employee", "fulfillment-employee-client"),
        ("resolver", "fulfillment-resolver-client"),
        ("customer", "fulfillment-customer-client"),
        ("shopping", "shopping-service-client"),
    ),
    variables=(
        ("shoppingToken", "shopping"),
        ("employeeToken", "employee"),
        ("otherEmployeeToken", "other-employee"),
        ("resolverToken", "resolver"),
        ("customerToken", "customer"),
    ),
    realm_documents=(SERVICES / "fulfillment/src/test/resources/iot-realm.json",),
    warmup=("/orders", "employee"),
)

# The service's own realm document is the only one — no vendored fallback. `customer-security`
# creates it; until then the infra step warns and skips this realm, so `deploy` of the other two
# services keeps working. Realm `shopping` and its tokens appear only once the file exists.
SHOPPING = App(
    name="shopping",
    port=8082,
    realm="shopping",
    suite="e2e/healthcheck.hurl",
    users=(("customer", "customer-client"),),
    variables=(("customerToken", "customer"),),
    realm_documents=(SERVICES / "shopping/src/test/resources/shopping-realm.json",),
    warmup=("/actuator/info", "customer"),
)

APPS = {app.name: app for app in (CATALOG, FULFILLMENT, SHOPPING)}
APP_ORDER = ("catalog", "fulfillment", "shopping")


def app_named(name: str) -> App:
    if name not in APPS:
        raise Fail(f"unknown service {name!r}; this environment manages {', '.join(APP_ORDER)}")
    return APPS[name]


def targets(name: str | None) -> list[App]:
    """No argument means every service, in a fixed order."""
    return [app_named(name)] if name else [APPS[service] for service in APP_ORDER]


# ── process plumbing ──────────────────────────────────────────────────────────────────────────────


def tail(text: str, lines: int = 25) -> str:
    kept = [line for line in (text or "").splitlines() if line.strip()][-lines:]
    return "\n".join(kept)


def run(cmd, *, cwd=None, timeout=120, check=True, stdin=None, input=None):
    args = [str(c) for c in cmd]
    try:
        done = subprocess.run(
            args,
            cwd=str(cwd) if cwd else None,
            timeout=timeout,
            stdin=stdin,
            input=input,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as missing:
        raise Fail(f"{args[0]} is not installed: {missing}") from missing
    except subprocess.TimeoutExpired as expired:
        raise Fail(f"timed out after {timeout}s: {' '.join(args)}") from expired
    if check and done.returncode != 0:
        raise Fail(
            f"command failed with exit {done.returncode}: {' '.join(args)}\n{tail((done.stdout or '') + (done.stderr or ''))}"
        )
    return done


def step(name: str) -> None:
    print(f"==> {name}", flush=True)


def ok(message: str) -> None:
    print(f"    {message}", flush=True)


def warn(message: str) -> None:
    print(f"    warning: {message}", flush=True)


WARNED_UNCONFIGURED: set[str] = set()


def not_configured(app: App, what: str) -> None:
    """One line per service and command, however many passes look at its realm."""
    if app.name in WARNED_UNCONFIGURED:
        return
    WARNED_UNCONFIGURED.add(app.name)
    warn(f"no realm document for {app.name}, so {what}; looked for {app.realm_document_paths()}")


# ── state ────────────────────────────────────────────────────────────────────────────────────────


def empty_state() -> dict:
    return {
        "version": STATE_VERSION,
        "cluster": None,
        "hostProcesses": {},
        "services": {name: {"image": APPS[name].image} for name in APP_ORDER},
        "realmsHash": None,
        "auth": None,
        "updatedAt": None,
    }


def load_state() -> dict:
    base = empty_state()
    if not STATE_FILE.exists():
        return base
    try:
        stored = json.loads(STATE_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return base
    base.update(stored)
    base["version"] = STATE_VERSION
    base["hostProcesses"] = dict(stored.get("hostProcesses") or {})
    base["services"] = {**empty_state()["services"], **(stored.get("services") or {})}
    return base


def save_state(state: dict) -> None:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    state["updatedAt"] = now_iso()
    tmp = STATE_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(STATE_FILE)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ── podman / kubectl ─────────────────────────────────────────────────────────────────────────────


def podman(*args, **kwargs):
    return run(["podman", *args], **kwargs)


def kubectl(*args, **kwargs):
    return run(["kubectl", "--kubeconfig", KUBECONFIG, *args], **kwargs)


def podman_reachable() -> bool:
    return podman("info", "--format", "{{.Host.Arch}}", check=False, timeout=60).returncode == 0


def ensure_machine() -> None:
    if podman_reachable():
        ok("podman machine reachable")
        return
    print("    podman machine not reachable — starting it", flush=True)
    started = podman("machine", "start", check=False, timeout=300)
    if started.returncode != 0 or not podman_reachable():
        raise Fail(f"podman machine cannot start:\n{tail((started.stdout or '') + (started.stderr or ''))}")
    ok("podman machine started")


def cluster_container() -> dict | None:
    if not podman_reachable():
        return None
    found = podman(
        "inspect", "--format", "{{.State.Running}}|{{.State.Status}}|{{.ImageName}}|{{.State.StartedAt}}",
        CLUSTER, check=False, timeout=60,
    )
    if found.returncode != 0:
        return None
    running, status, image, started = (found.stdout.strip().split("|") + ["", "", "", ""])[:4]
    return {"running": running == "true", "status": status, "image": image, "startedAt": started}


def ensure_cluster() -> None:
    container = cluster_container()
    if container and container["running"]:
        ok(f"cluster container {CLUSTER} already running")
        return
    if container:
        podman("start", CLUSTER, timeout=180)
        ok(f"cluster container {CLUSTER} restarted")
        return
    local = podman("images", "--format", "{{.Repository}}:{{.Tag}}", K3S_IMAGE, check=False, timeout=60)
    if K3S_IMAGE not in local.stdout.split():
        print(f"    pulling {K3S_IMAGE}", flush=True)
        podman("pull", K3S_IMAGE, timeout=900)
    podman(
        "run", "-d", "--name", CLUSTER, "--privileged", "--hostname", "k3s",
        "-p", f"{API_PORT}:6443",
        K3S_IMAGE, "server",
        "--disable=traefik", "--disable=servicelb", "--disable=metrics-server",
        "--write-kubeconfig-mode=644", "--tls-san=127.0.0.1",
        # The podman machine is a shared 100 GiB disk that other work also fills. k3s defaults to
        # evicting at 5 % free (5 GiB here), which is more than these pods can ever use; a 1 GiB
        # floor still leaves the node honest about a genuinely full disk without evicting the stack.
        "--kubelet-arg=eviction-hard=imagefs.available<1Gi,nodefs.available<1Gi",
        timeout=180,
    )
    ok(f"cluster container {CLUSTER} created (image {K3S_IMAGE}, api 127.0.0.1:{API_PORT})")


def container_exists(name: str) -> bool:
    if not podman_reachable():
        return False
    return podman("container", "exists", name, check=False, timeout=60).returncode == 0


def reclaim_legacy() -> None:
    """A stopped `catalog-k3s` from the per-service layout is announced and removed, never left beside
    the shop-wide cluster."""
    step(f"legacy layout ({', '.join(LEGACY_CLUSTERS)})")
    reclaimed = []
    for name in LEGACY_CLUSTERS:
        if not container_exists(name):
            continue
        print(f"    {name} is the per-service cluster of the old layout, replaced by {CLUSTER} — removing it", flush=True)
        podman("rm", "-f", name, check=False, timeout=120)
        if container_exists(name):
            raise Fail(f"the legacy cluster container {name} cannot be removed; free it with `podman rm -f {name}`")
        reclaimed.append(name)
    for stale in LEGACY_KUBECONFIGS:
        if stale.exists():
            stale.unlink()
            reclaimed.append(str(stale.relative_to(WORKSPACE)))
    ok(f"removed {', '.join(reclaimed)}" if reclaimed else f"none, {CLUSTER} is the only cluster")


def write_kubeconfig() -> None:
    """k3s writes its kubeconfig only after the API server starts, so the read is bounded."""
    RUNTIME.mkdir(parents=True, exist_ok=True)
    deadline = time.time() + T_NODE_READY
    document = ""
    while time.time() < deadline:
        found = podman("exec", CLUSTER, "cat", "/etc/rancher/k3s/k3s.yaml", check=False, timeout=60)
        if found.returncode == 0 and "server:" in (found.stdout or ""):
            document = found.stdout
            break
        state = cluster_container()
        if state and not state["running"]:
            logs = podman("logs", "--tail", "20", CLUSTER, check=False, timeout=30)
            raise Fail(f"cluster container {CLUSTER} exited while starting\n{tail((logs.stdout or '') + (logs.stderr or ''))}")
        time.sleep(2)
    if not document:
        raise Fail(f"{CLUSTER} did not write /etc/rancher/k3s/k3s.yaml within {T_NODE_READY}s")
    document = document.replace("server: https://127.0.0.1:6443", f"server: https://127.0.0.1:{API_PORT}")
    for field, value in (
        ("name: default", f"name: {CLUSTER}"),
        ("cluster: default", f"cluster: {CLUSTER}"),
        ("user: default", f"user: {CLUSTER}"),
        ("current-context: default", f"current-context: {CLUSTER}"),
    ):
        document = document.replace(field, value)
    KUBECONFIG.write_text(document)
    os.chmod(KUBECONFIG, 0o600)
    ok(f"kubeconfig {KUBECONFIG.relative_to(WORKSPACE)} (context {CLUSTER})")


def node_state() -> tuple[str | None, str]:
    if not KUBECONFIG.exists():
        return None, "kubeconfig absent"
    found = kubectl(
        "get", "nodes", "--no-headers",
        "-o", "custom-columns=NAME:.metadata.name,READY:.status.conditions[?(@.type=='Ready')].status",
        check=False, timeout=30,
    )
    if found.returncode != 0:
        return None, tail((found.stdout or "") + (found.stderr or ""), 5)
    for line in found.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "True":
            return parts[0], "Ready"
    return None, "no node reports Ready=True"


def wait_node_ready(timeout: int = T_NODE_READY) -> None:
    deadline = time.time() + timeout
    detail = ""
    while time.time() < deadline:
        node, detail = node_state()
        if node:
            ok(f"node {node} Ready")
            return
        time.sleep(2)
    logs = podman("logs", "--tail", "20", CLUSTER, check=False, timeout=30)
    raise Fail(f"node not Ready after {timeout}s ({detail})\n{tail((logs.stdout or '') + (logs.stderr or ''))}")


def rollout_status(namespace: str, deployment: str, timeout: int = T_ROLLOUT) -> None:
    done = kubectl(
        "-n", namespace, "rollout", "status", f"deployment/{deployment}",
        f"--timeout={timeout}s", check=False, timeout=timeout + 30,
    )
    if done.returncode != 0:
        raise Fail(f"deployment/{deployment} in {namespace} did not become Ready\n{diagnose(namespace, deployment)}")
    ok(f"deployment/{deployment} Ready ({namespace})")


def disk_free_gib() -> float | None:
    found = podman("exec", CLUSTER, "df", "-Pk", "/", check=False, timeout=30)
    lines = (found.stdout or "").splitlines()
    if len(lines) < 2:
        return None
    fields = lines[1].split()
    if len(fields) < 4 or not fields[3].isdigit():
        return None
    return int(fields[3]) / (1024 * 1024)


def check_disk() -> None:
    """k3s evicts every pod under disk pressure, which reads as an unexplained rollout timeout."""
    free = disk_free_gib()
    if free is None:
        return
    if free < 3:
        raise Fail(
            f"the podman machine disk has {free:.1f} GiB free — k3s will evict every pod under disk pressure.\n"
            f"Free space first: `podman image prune -f`, then `podman system df` and `podman volume ls`."
        )
    if free < 8:
        print(f"    warning: {free:.1f} GiB free on the podman machine disk", flush=True)


def node_conditions() -> str:
    found = kubectl("get", "node", "-o", "wide", check=False, timeout=30)
    return tail(found.stdout or "", 5)


def diagnose(namespace: str, deployment: str) -> str:
    parts = [node_conditions()]
    pods = kubectl("-n", namespace, "get", "pods", "-l", f"app={deployment}", "-o", "wide", check=False, timeout=30)
    parts.append(tail(pods.stdout or "", 10))
    for pod in pod_names(namespace, f"app={deployment}"):
        described = kubectl("-n", namespace, "describe", "pod", pod, check=False, timeout=30)
        events = [line for line in (described.stdout or "").splitlines() if line.startswith("  ") and ":" in line]
        parts.append(f"--- {pod} events ---\n" + tail("\n".join(events), 12))
        logged = kubectl("-n", namespace, "logs", pod, "--tail", "30", check=False, timeout=60)
        parts.append(f"--- {pod} logs ---\n" + tail((logged.stdout or "") + (logged.stderr or ""), 30))
    return "\n".join(p for p in parts if p.strip())


def pod_names(namespace: str, selector: str) -> list[str]:
    command = ["-n", namespace, "get", "pods"]
    if selector:
        command += ["-l", selector]
    command += ["-o", "jsonpath={.items[*].metadata.name}"]
    found = kubectl(*command, check=False, timeout=30)
    return (found.stdout or "").split()


def pod_phase(namespace: str, selector: str) -> str:
    found = kubectl("-n", namespace, "get", "pods", "-l", selector, "-o",
                    "jsonpath={.items[*].status.phase}", check=False, timeout=30)
    return " ".join((found.stdout or "").split())


# ── http ────────────────────────────────────────────────────────────────────────────────────────


def http_get(url: str, timeout: int = 5) -> tuple[int, str]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as answer:
            return answer.status, answer.read(400).decode("utf-8", "replace")
    except urllib.error.HTTPError as failure:
        return failure.code, failure.read(400).decode("utf-8", "replace")
    except (urllib.error.URLError, OSError) as unreachable:
        return 0, str(unreachable)


def health(app: App) -> tuple[bool, str]:
    status, body = http_get(app.health_url)
    try:
        verdict = json.loads(body).get("status", "")
    except json.JSONDecodeError:
        verdict = ""
    return (status == 200 and verdict == "UP"), f"{status} {verdict}".strip()


def answers(url: str, timeout: int = 15) -> bool:
    """A port-forward survives a rollout but drops its connection for a moment; give it that moment."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if http_get(url)[0] in (200, 401):
            return True
        time.sleep(1)
    return False


def forward_alive(name: str) -> bool:
    entry = load_state()["hostProcesses"].get(name) or {}
    return pid_alive(int(entry.get("pid", 0)))


def wait_health(app: App, timeout: int = T_HEALTH) -> None:
    deadline = time.time() + timeout
    last = ""
    recovered = False
    while time.time() < deadline:
        healthy, last = health(app)
        if healthy:
            ok(f"GET /actuator/health → {last} on {app.url}")
            return
        if not recovered and not forward_alive(app.forward):
            # A rollout replaces the pod, and kubectl's forward dies with it (`lost connection to
            # pod`); the health of the new pod is what this wait is for.
            print(f"    {app.name}: the port-forward died with the old pod — restarting it", flush=True)
            ensure_forward(app.forward, app.namespace, app.port, f"svc/{app.service}", app.service_port)
            recovered = True
            continue
        time.sleep(3)
    raise Fail(f"{app.name} health not UP after {timeout}s (last {last or 'no answer'})\n{diagnose(app.namespace, app.deployment)}")


# ── host-side port-forwards ────────────────────────────────────────────────────────────────────


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except (OSError, ValueError):
        return False
    return True


def terminate(pid: int, timeout: int = 10) -> None:
    if not pid_alive(pid):
        return
    try:
        os.killpg(os.getpgid(pid), signal.SIGTERM)
    except OSError:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            return
    deadline = time.time() + timeout
    while time.time() < deadline and pid_alive(pid):
        time.sleep(0.2)
    if pid_alive(pid):
        try:
            os.killpg(os.getpgid(pid), signal.SIGKILL)
        except OSError:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass


def forward_orphans() -> list[int]:
    """kubectl port-forwards of this workspace that the state file forgot."""
    found = run(["ps", "-Ao", "pid=,command="], check=False, timeout=30)
    pids = []
    for line in (found.stdout or "").splitlines():
        line = line.strip()
        if "port-forward" not in line or "kubectl" not in line:
            continue
        if str(KUBECONFIG) not in line and not any(str(old) in line for old in LEGACY_KUBECONFIGS):
            continue
        try:
            pids.append(int(line.split(None, 1)[0]))
        except ValueError:
            continue
    return pids


def stop_forwards(state: dict) -> list[str]:
    stopped = []
    for name, entry in list(state["hostProcesses"].items()):
        terminate(int(entry.get("pid", 0)))
        stopped.append(f"{name} (pid {entry.get('pid')})")
        state["hostProcesses"].pop(name, None)
    for pid in forward_orphans():
        terminate(pid)
        stopped.append(f"orphan port-forward (pid {pid})")
    return stopped


def ensure_forward(name: str, namespace: str, local: int, target: str, remote: int,
                   health_url: str | None = None) -> dict:
    state = load_state()
    entry = state["hostProcesses"].get(name)
    if entry and pid_alive(int(entry["pid"])):
        if health_url is None or answers(health_url):
            ok(f"{name}: http://127.0.0.1:{local} → {namespace}/{target}:{remote} already up (pid {entry['pid']})")
            return entry
        print(f"    {name} on {local} is alive but not answering for 15s — restarting it", flush=True)
        terminate(int(entry["pid"]))
        state["hostProcesses"].pop(name, None)
    elif entry:
        state["hostProcesses"].pop(name, None)

    for pid in port_listeners(local):
        raise Fail(f"host port {local} is already taken by pid {pid} ({process_command(pid)}); run `run-apps stop`")

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"port-forward-{name}.log"
    handle = open(log_path, "wb")
    process = subprocess.Popen(
        ["kubectl", "--kubeconfig", str(KUBECONFIG), "-n", namespace, "port-forward", target, f"{local}:{remote}"],
        stdout=handle, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True,
    )
    handle.close()
    entry = {
        "pid": process.pid,
        "localPort": local,
        "namespace": namespace,
        "target": target,
        "remotePort": remote,
        "url": f"http://127.0.0.1:{local}",
        "log": str(log_path.relative_to(WORKSPACE)),
        "startedAt": now_iso(),
    }
    state["hostProcesses"][name] = entry
    save_state(state)

    deadline = time.time() + T_FORWARD
    while time.time() < deadline:
        if process.poll() is not None:
            raise Fail(f"port-forward {namespace}/{target} → {local} exited\n{tail(log_path.read_text(errors='replace'))}")
        if health_url and http_get(health_url)[0] in (200, 401):
            ok(f"{name}: http://127.0.0.1:{local} → {namespace}/{target}:{remote} (pid {process.pid})")
            return entry
        if health_url is None:
            ok(f"{name}: http://127.0.0.1:{local} → {namespace}/{target}:{remote} (pid {process.pid})")
            return entry
        time.sleep(1)
    raise Fail(f"port-forward {namespace}/{target} → {local} did not answer within {T_FORWARD}s\n{tail(log_path.read_text(errors='replace'))}")


# ── ports ──────────────────────────────────────────────────────────────────────────────────────


def port_listeners(port: int) -> list[int]:
    found = run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], check=False, timeout=20)
    return [int(value) for value in (found.stdout or "").split() if value.isdigit()]


def process_command(pid: int) -> str:
    found = run(["ps", "-o", "command=", "-p", str(pid)], check=False, timeout=20)
    return tail(found.stdout or "", 1)


def free_ports(ports: tuple[int, ...]) -> tuple[list[str], list[str]]:
    """Kill leftover port-forwards on our ports; never touch a process that is something else."""
    freed, problems = [], []
    for port in ports:
        for pid in port_listeners(port):
            command = process_command(pid)
            if "port-forward" in command and "kubectl" in command:
                terminate(pid)
                freed.append(f"port {port}: killed port-forward pid {pid}")
            else:
                problems.append(f"port {port} held by pid {pid} ({command}) — not a port-forward, not killing it")
    for port in ports:
        if port_listeners(port) and not any(problem.startswith(f"port {port} ") for problem in problems):
            problems.append(f"port {port} still held by {', '.join(map(str, port_listeners(port)))} after SIGKILL")
    return freed, problems


# ── infra and app manifests ───────────────────────────────────────────────────────────────────


def ensure_namespace(namespace: str) -> None:
    document = kubectl("create", "namespace", namespace, "--dry-run=client", "-o", "yaml", timeout=30).stdout
    kubectl("apply", "-f", "-", input=document, timeout=60)


def ensure_realm_configmap() -> str:
    """One Keycloak, one ConfigMap, one realm document per service. `--import-realm` reads the
    directory the ConfigMap is mounted into, so every realm comes up together. A service whose
    document does not exist yet is skipped with a warning instead of failing the infra step: one
    scaffolded service must not take the two deployed ones down with it."""
    sources = []
    for name in APP_ORDER:
        app = APPS[name]
        if not app.configured:
            not_configured(app, f"realm {app.realm} is not imported")
            continue
        document = app.realm_document()
        sources.append(f"--from-file={document.name}={document}")
    if not sources:
        raise Fail("no realm document exists for any service; nothing to import")
    rendered = kubectl(
        "-n", NAMESPACE, "create", "configmap", KEYCLOAK_REALMS, *sources,
        "--dry-run=client", "-o", "yaml", timeout=60,
    )
    kubectl("apply", "-f", "-", input=rendered.stdout, timeout=60)
    digest = hashlib.sha256(rendered.stdout.encode()).hexdigest()[:12]
    imported = [name for name in APP_ORDER if APPS[name].configured]
    ok(f"realms {', '.join(APPS[name].realm for name in imported)} in {KEYCLOAK_REALMS} ({digest})")
    return digest


def apply_infra() -> None:
    ensure_namespace(NAMESPACE)
    digest = ensure_realm_configmap()
    kubectl("apply", "-f", MANIFESTS / "infra", timeout=120)
    ok("manifests/infra applied (postgresql with one database per service, kafka, keycloak)")
    state = load_state()
    exists = kubectl("-n", NAMESPACE, "get", "deployment", "keycloak", check=False, timeout=30).returncode == 0
    if exists and state["realmsHash"] not in (None, digest):
        # `--import-realm` reads the directory only at startup and skips a realm that already exists,
        # so a changed realm set is applied by restarting the one Keycloak.
        print("    the realm documents changed — restarting keycloak to import them", flush=True)
        kubectl("-n", NAMESPACE, "rollout", "restart", "deployment/keycloak", timeout=60)
    state["realmsHash"] = digest
    save_state(state)


def app_manifest(app: App) -> str:
    return kubectl("kustomize", "--load-restrictor", "LoadRestrictionsNone", app.manifest, timeout=120).stdout


def configmap_digest(rendered: str) -> str:
    blocks = [block for block in rendered.split("\n---\n")
              if re.search(r"^kind: ConfigMap$", block, re.MULTILINE)]
    return hashlib.sha256("\n---\n".join(blocks).encode()).hexdigest()[:12]


def apply_app(app: App) -> None:
    rendered = app_manifest(app)
    existed = kubectl("-n", app.namespace, "get", "deployment", app.deployment,
                      check=False, timeout=30).returncode == 0
    applied = kubectl("apply", "-f", "-", input=rendered, timeout=120).stdout
    ok(f"{app.name}: overlays/k3d + shared addresses + otel collector (namespace {app.namespace})")
    digest = configmap_digest(rendered)
    state = load_state()
    entry = state["services"].setdefault(app.name, {"image": app.image})
    # A merge-generated ConfigMap keeps its name, so a content change does not roll the Deployment,
    # and env read from configMapKeyRef is only read at container start.
    changed = re.search(r"^configmap/\S+ (created|configured)$", applied, re.MULTILINE) is not None
    if existed and (changed or entry.get("configMapsHash") != digest):
        print(f"    {app.name}: its ConfigMap changed — restarting the deployment", flush=True)
        kubectl("-n", app.namespace, "rollout", "restart", f"deployment/{app.deployment}", timeout=60)
    entry["configMapsHash"] = digest
    save_state(state)


# ── image pipeline ────────────────────────────────────────────────────────────────────────────


def node_architecture() -> str:
    """The arch the node runs, which is the arch the image must have. Jib defaults to linux/amd64."""
    found = kubectl("get", "nodes", "--no-headers", "-o",
                    "jsonpath={.items[0].status.nodeInfo.architecture}", check=False, timeout=30)
    arch = (found.stdout or "").strip()
    if arch:
        return "amd64" if arch == "x86_64" else arch
    machine = platform.machine().lower()
    return "amd64" if machine in ("x86_64", "amd64") else "arm64"


def tar_architecture(tar: Path) -> str:
    try:
        with tarfile.open(tar) as archive:
            manifest = json.load(archive.extractfile("manifest.json"))
            config = json.load(archive.extractfile(manifest[0]["Config"]))
            return config.get("architecture", "")
    except (KeyError, IndexError, OSError, json.JSONDecodeError, tarfile.TarError):
        return ""


def newest_source_mtime(app: App) -> float:
    newest = 0.0
    for root in (app.directory / "src", app.directory / "config"):
        for path in root.rglob("*"):
            if path.is_file():
                newest = max(newest, path.stat().st_mtime)
    for path in (app.directory / "build.gradle", app.directory / "settings.gradle"):
        if path.exists():
            newest = max(newest, path.stat().st_mtime)
    return newest


def cluster_images() -> str:
    if not cluster_container():
        return ""
    found = podman("exec", CLUSTER, "ctr", "-n", "k8s.io", "images", "ls", "-q", check=False, timeout=120)
    return found.stdout or ""


def cluster_has_image(app: App) -> bool:
    return bool(re.search(rf"(^|/){re.escape(app.image)}$", cluster_images(), re.MULTILINE))


def build_image(app: App, force: bool, skip_build: bool) -> tuple[Path, bool]:
    """Returns the tar and whether it was built by this call."""
    tar = app.tar
    arch = node_architecture()
    target = f"linux/{arch}"
    if tar.exists() and tar_architecture(tar) != arch:
        print(f"    {tar.name} is {tar_architecture(tar) or 'unknown'}, the node is {target} — rebuilding", flush=True)
        skip_build = False
    if skip_build:
        if not tar.exists():
            raise Fail(f"--skip-build was asked for but {tar} does not exist")
        ok(f"{app.name}: image tar reused (--skip-build, {target})")
        return tar, False
    if not force and tar.exists() and tar.stat().st_mtime >= newest_source_mtime(app):
        ok(f"{app.name}: image tar up to date ({target}, {tar.stat().st_size // (1024 * 1024)} MiB)")
        return tar, False
    print(f"    {app.name}: ./gradlew jibBuildTar -Djib.from.platforms={target}", flush=True)
    built = run(
        ["./gradlew", "jibBuildTar", f"-Djib.from.platforms={target}", "--console=plain"],
        cwd=app.directory, timeout=T_BUILD, check=False,
    )
    if built.returncode != 0:
        raise Fail(f"{app.name}: jibBuildTar failed with exit {built.returncode}\n"
                   f"{tail((built.stdout or '') + (built.stderr or ''), 40)}")
    if not tar.exists():
        raise Fail(f"{app.name}: jibBuildTar reported success but {tar} does not exist")
    if tar_architecture(tar) != arch:
        raise Fail(f"{tar} is {tar_architecture(tar) or 'unknown'} but the node runs {target}; "
                   f"Jib was not switched by -Djib.from.platforms")
    ok(f"{app.name}: image tar built ({target}, {tar.stat().st_size // (1024 * 1024)} MiB)")
    return tar, True


def import_image(app: App, tar: Path) -> None:
    with open(tar, "rb") as image:
        imported = podman(
            "exec", "-i", CLUSTER, "ctr", "-n", "k8s.io", "images", "import", "-",
            stdin=image, check=False, timeout=600,
        )
    if imported.returncode != 0:
        raise Fail(f"ctr images import failed with exit {imported.returncode}\n{tail((imported.stdout or '') + (imported.stderr or ''))}")
    if not cluster_has_image(app):
        raise Fail(f"{app.image} is not in the cluster image store after the import")
    ok(f"{app.image} imported into k3s containerd")


def restart_deployment(app: App) -> None:
    kubectl("-n", app.namespace, "rollout", "restart", f"deployment/{app.deployment}", timeout=60)
    rollout_status(app.namespace, app.deployment)


# ── auth ──────────────────────────────────────────────────────────────────────────────────────


def ensure_keycloak_forward() -> None:
    ensure_forward("keycloak", NAMESPACE, KEYCLOAK_PORT, f"svc/{KEYCLOAK_SERVICE}", 8080,
                   health_url=f"http://127.0.0.1:{KEYCLOAK_PORT}/realms/{CATALOG.realm}")


def keycloak_running() -> bool:
    return pod_phase(NAMESPACE, "app=keycloak") == "Running"


def mint_realm(app: App) -> dict:
    endpoint = f"http://127.0.0.1:{KEYCLOAK_PORT}/realms/{app.realm}/protocol/openid-connect/token"
    tokens = {}
    for user, client in app.users:
        payload = urllib.parse.urlencode({
            "grant_type": "password",
            "client_id": client,
            "client_secret": "secret",
            "username": user,
            "password": user,
            "scope": "openid",
        }).encode()
        request = urllib.request.Request(endpoint, data=payload,
                                         headers={"Content-Type": "application/x-www-form-urlencoded"})
        try:
            with urllib.request.urlopen(request, timeout=20) as answer:
                body = json.loads(answer.read())
        except urllib.error.HTTPError as failure:
            raise Fail(f"keycloak refused the password grant for {user} in realm {app.realm}: "
                       f"{failure.code} {failure.read(400).decode('utf-8', 'replace')}") from failure
        except (urllib.error.URLError, OSError) as unreachable:
            raise Fail(f"keycloak is not reachable at {endpoint}: {unreachable}") from unreachable
        issued = datetime.now(timezone.utc)
        tokens[user] = {
            "token": body["access_token"],
            "scope": body.get("scope", ""),
            "clientId": client,
            "issuedAt": issued.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "expiresAt": (issued + timedelta(seconds=int(body.get("expires_in", 3600)))).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "expiresIn": int(body.get("expires_in", 3600)),
        }
    return {"realm": app.realm, "endpoint": endpoint, "tokens": tokens}


def mint_tokens() -> dict:
    if not cluster_container() or not cluster_container()["running"]:
        raise Fail("the cluster is not running — `run-apps deploy` first")
    if not keycloak_running():
        raise Fail(f"keycloak is not Running (phase: {pod_phase(NAMESPACE, 'app=keycloak') or 'absent'}) — `run-apps deploy` first")
    ensure_keycloak_forward()

    realms = {}
    for name in APP_ORDER:
        app = APPS[name]
        if not app.configured:
            not_configured(app, f"realm {app.realm} has no tokens")
            continue
        realms[app.realm] = mint_realm(app)
    # Reload first: the port-forward started above was recorded in the state file after this
    # command began, and a save from the older copy would drop it.
    state = load_state()
    state["auth"] = {"issuedAt": now_iso(), "realms": realms}
    save_state(state)
    write_tokens_env(state["auth"])
    return state["auth"]


def write_tokens_env(auth: dict) -> Path:
    lines = []
    for name in APP_ORDER:
        app = APPS[name]
        realm = auth["realms"].get(app.realm)
        if not realm:
            continue
        for user, _ in app.users:
            token = realm["tokens"][user]["token"]
            lines.append(f"export {name.upper()}_{user.upper().replace('-', '_')}_TOKEN='{token}'")
    TOKENS_ENV.write_text("\n".join(lines) + "\n")
    os.chmod(TOKENS_ENV, 0o600)
    return TOKENS_ENV


def tokens_valid(auth: dict | None) -> bool:
    if not auth or not auth.get("realms"):
        return False
    for name in APP_ORDER:
        app = APPS[name]
        if not app.configured:
            continue
        realm = auth["realms"].get(app.realm) or {}
        for user, _ in app.users:
            entry = (realm.get("tokens") or {}).get(user)
            if not entry:
                return False
            expires = datetime.strptime(entry["expiresAt"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
            if expires - datetime.now(timezone.utc) < timedelta(seconds=60):
                return False
    return True


# ── commands ─────────────────────────────────────────────────────────────────────────────────


def deploy_app(app: App, args) -> None:
    step(f"image {app.name}")
    tar, built = build_image(app, force=args.force_build, skip_build=args.skip_build)
    if built or args.force_build or not cluster_has_image(app):
        import_image(app, tar)
    else:
        ok(f"cluster already carries {app.image}")
    step(f"{app.name} manifests")
    apply_app(app)
    step(f"{app.name} rollout")
    rollout_status(app.namespace, app.deployment)
    step(f"{app.name} host port-forward")
    ensure_forward(app.forward, app.namespace, app.port, f"svc/{app.service}", app.service_port,
                   health_url=app.health_url)
    step(f"{app.name} health")
    wait_health(app)


def cmd_deploy(args) -> int:
    chosen = targets(args.service)
    step("podman machine")
    ensure_machine()
    reclaim_legacy()
    step(f"cluster {CLUSTER}")
    ensure_cluster()
    state = load_state()
    state["cluster"] = {
        "name": CLUSTER,
        "container": CLUSTER,
        "image": K3S_IMAGE,
        "apiPort": API_PORT,
        "kubeconfig": str(KUBECONFIG.relative_to(WORKSPACE)),
        "context": CLUSTER,
        "startedAt": (cluster_container() or {}).get("startedAt"),
    }
    save_state(state)
    step("kubeconfig")
    write_kubeconfig()
    step("node readiness")
    wait_node_ready()
    check_disk()
    step("infra manifests")
    apply_infra()
    step("infra readiness")
    for deployment in INFRA_DEPLOYMENTS:
        rollout_status(NAMESPACE, deployment)
    for app in chosen:
        deploy_app(app, args)
    listed = ", ".join(f"{app.name} at {app.url}" for app in chosen)
    print(f"\n{listed} — `run-apps status`, `run-apps auth`, `run-apps test`.")
    return 0


def postgres_databases() -> list[str]:
    """The logical databases the shop-wide instance carries — one per service, from databases.txt."""
    found = kubectl(
        "-n", NAMESPACE, "exec", f"deploy/{POSTGRES}", "--",
        "psql", "-U", "postgres", "-d", "postgres", "-tAc",
        "SELECT datname FROM pg_database WHERE datname NOT LIKE 'template%' AND datname <> 'postgres' ORDER BY 1",
        check=False, timeout=30,
    )
    return (found.stdout or "").split() if found.returncode == 0 else []


def queried(namespace: str, *query: str) -> str:
    found = kubectl("-n", namespace, *query, check=False, timeout=60)
    return found.stdout if found.returncode == 0 else tail((found.stdout or "") + (found.stderr or ""), 5)


def deployment_exists(namespace: str, name: str) -> bool:
    found = kubectl("-n", namespace, "get", "deployment", name, "-o", "name", check=False, timeout=30)
    return found.returncode == 0


def cmd_status(args) -> int:
    state = load_state()
    container = cluster_container()
    running = bool(container and container["running"])
    report = {
        "podmanMachine": podman_reachable(),
        "clusterContainer": container,
        "legacyContainers": [name for name in LEGACY_CLUSTERS if podman_reachable() and container_exists(name)],
        "node": None,
        "databases": [],
        "namespaces": {},
        "apps": {},
        "hostProcesses": [],
    }
    if running:
        report["node"] = node_state()[0]
        report["databases"] = postgres_databases()
        infra_selector = f"app in ({POSTGRES},kafka,keycloak,otel-collector)"
        report["namespaces"][NAMESPACE] = {
            "pods": queried(NAMESPACE, "get", "pods", "-l", infra_selector, "-o", "wide"),
            "services": queried(NAMESPACE, "get", "services", "-l", infra_selector, "-o", "wide"),
            "endpoints": queried(NAMESPACE, "get", "endpoints", "-l", infra_selector),
        }
        for name in APP_ORDER:
            app = APPS[name]
            deployment = queried(app.namespace, "get", "deployment", app.deployment, "--no-headers")
            report["apps"][name] = {
                "namespace": app.namespace,
                "port": app.port,
                "realm": app.realm,
                "configured": app.configured,
                "deployed": deployment_exists(app.namespace, app.deployment),
                "deployment": " ".join(deployment.split()),
                "ready": re.search(rf"{app.deployment}\s+1/1", deployment) is not None,
                "pods": " ".join(pod_names(app.namespace, f"app={app.deployment}")),
                "health": health(app),
            }
        forwards = {candidate.forward: candidate for candidate in APPS.values()}
        for name, entry in state["hostProcesses"].items():
            alive = pid_alive(int(entry["pid"]))
            app = forwards.get(name)
            healthy, detail = (False, "not answering")
            if alive:
                healthy, detail = (health(app) if app
                                   else (http_get(f"{entry['url']}/realms/{CATALOG.realm}")[0] == 200, "200"))
            report["hostProcesses"].append({**entry, "alive": alive, "healthy": healthy, "detail": detail})

    # A service whose realm document does not exist yet cannot be configured on the cluster, so the
    # verdict does not depend on it — unless it IS deployed and unhealthy, which is a real RED.
    counted = {
        name: entry for name, entry in report["apps"].items()
        if entry["configured"] or (entry["deployed"] and not (entry["ready"] and entry["health"][0]))
    }
    green = (running and bool(report["node"])
             and len(report["apps"]) == len(APP_ORDER)
             and all(entry["ready"] and entry["health"][0] for entry in counted.values()))
    # Nothing running at all is the state `stop` leaves behind, and it is not a failure.
    idle = not running and not report["hostProcesses"]
    state_name = "green" if green else "none" if idle else "red"

    if args.json:
        print(json.dumps({**report, "state": state_name}, indent=2))
    else:
        print("== runtime ==")
        print(f"podman machine      {'UP' if report['podmanMachine'] else 'DOWN'}")
        if container:
            print(f"cluster container   {CLUSTER} {'RUNNING' if container['running'] else container['status'].upper()} "
                  f"({K3S_IMAGE}, api 127.0.0.1:{API_PORT})")
        else:
            print(f"cluster container   {CLUSTER} ABSENT")
        print(f"node                {report['node'] or 'none Ready'}")
        print(f"kubeconfig          {KUBECONFIG.relative_to(WORKSPACE) if KUBECONFIG.exists() else 'absent'}")
        if running:
            print(f"databases           {', '.join(report['databases']) or 'unreachable'} (instance {POSTGRES})")
        else:
            print(f"databases           n/a — cluster down (instance {POSTGRES})")
        for legacy in report["legacyContainers"]:
            print(f"legacy container    {legacy} PRESENT — the old per-service cluster; `run-apps deploy` removes it")

        for name in APP_ORDER:
            app = APPS[name]
            entry = report["apps"].get(name)
            print(f"\n== {name} (namespace {app.namespace}, realm {app.realm}, {app.url}) ==")
            if not entry:
                print("(cluster down)")
                continue
            if not entry["configured"]:
                print(f"state               NOT CONFIGURED — no realm document yet ({app.realm_document_paths()})")
            print(f"pod                 {entry['pods'] or '(none)'}")
            print(f"deployment          {entry['deployment'] or '(absent)'}")
            print(f"health              GET /actuator/health → {entry['health'][1]}")

        print(f"\n== shared infra (namespace {NAMESPACE}) ==")
        for title, key in (("workloads", "pods"), ("services", "services"), ("endpoints", "endpoints")):
            if not running:
                print(f"{title:<12}(cluster down)")
                continue
            print(f"-- {title}")
            print((report["namespaces"][NAMESPACE][key] or "(none)").rstrip())

        print("\n== host bridges ==")
        if not report["hostProcesses"]:
            print("(none)")
        for entry in report["hostProcesses"]:
            print(f"{entry['url']:<28} -> {entry['namespace']}/{entry['target']}:{entry['remotePort']}  "
                  f"{'LIVE ' if entry['alive'] else 'DEAD '} pid {entry['pid']}  "
                  f"{'healthy' if entry['healthy'] else entry['detail']}")

        print("\n== verdict ==")
        unconfigured = [name for name in APP_ORDER if name in report["apps"] and not report["apps"][name]["configured"]]
        if running and unconfigured:
            warn(f"not configured (no realm document yet): {', '.join(unconfigured)}")
        if green:
            detail = ", ".join(f"{name} 1/1 {report['apps'][name]['health'][1]}"
                               for name in APP_ORDER if name in counted)
            print(f"GREEN — cluster up, {detail}")
        elif idle:
            print("NONE — nothing running (cluster absent, no host bridges)")
        else:
            problems = []
            if not running:
                problems.append("cluster down")
            if not report["node"]:
                problems.append("node not Ready")
            for name in APP_ORDER:
                entry = report["apps"].get(name)
                if not entry:
                    problems.append(f"{name} not deployed")
                    continue
                if name not in counted:
                    continue
                if not entry["ready"]:
                    problems.append(f"{name} not 1/1")
                if not entry["health"][0]:
                    problems.append(f"{name} health {entry['health'][1]}")
            print("RED — " + "; ".join(problems))
    return 0 if green or idle else 1


def cmd_logs(args) -> int:
    if not cluster_container() or not cluster_container()["running"]:
        raise Fail("the cluster is not running — `run-apps deploy` first")
    namespaces = list(dict.fromkeys((NAMESPACE, *(APPS[name].namespace for name in APP_ORDER))))
    sections: list[tuple[str, str]] = []
    if args.pod and args.pod in APPS:
        app = APPS[args.pod]
        sections = [(app.namespace, pod) for pod in pod_names(app.namespace, f"app={app.deployment}")]
        if not sections:
            raise Fail(f"no pod of {app.name} in namespace {app.namespace}")
    elif args.pod:
        for namespace in namespaces:
            if args.pod in pod_names(namespace, ""):
                sections.append((namespace, args.pod))
                break
        if not sections:
            raise Fail(f"pod {args.pod} not found in {', '.join(namespaces)}")
    elif args.infra:
        selector = f"app in ({POSTGRES},kafka,keycloak,otel-collector)"
        sections = [(namespace, pod) for namespace in namespaces for pod in pod_names(namespace, selector)]
        if not sections:
            raise Fail(f"no infra pod matches {selector} in {', '.join(namespaces)}")
    else:
        sections = [(APPS[name].namespace, pod) for name in APP_ORDER
                    for pod in pod_names(APPS[name].namespace, f"app={APPS[name].deployment}")]
        if not sections:
            raise Fail(f"no app pod in {', '.join(namespaces)}")

    print(f"logs for {', '.join(pod for _, pod in sections)} "
          f"(tail {args.tail}{', following' if args.follow else ''})", flush=True)
    for namespace, pod in sections:
        print(f"\n===== {namespace}/{pod} =====", flush=True)
        command = ["-n", namespace, "logs", pod, "--tail", str(args.tail)]
        if args.since:
            command += ["--since", args.since]
        if args.follow:
            command.append("-f")
        result = kubectl(*command, check=False, timeout=T_HURL if args.follow else 120)
        print(((result.stdout or "") + (result.stderr or "")).rstrip(), flush=True)
    return 0


def cmd_rebuild(args) -> int:
    chosen = targets(args.service)
    step("cluster")
    ensure_cluster()
    write_kubeconfig()
    wait_node_ready()
    check_disk()
    for app in chosen:
        before = " ".join(pod_names(app.namespace, f"app={app.deployment}"))
        step(f"image {app.name}")
        tar, _ = build_image(app, force=True, skip_build=False)
        import_image(app, tar)
        step(f"{app.name} rollout restart")
        restart_deployment(app)
        step(f"{app.name} host port-forward")
        ensure_forward(app.forward, app.namespace, app.port, f"svc/{app.service}", app.service_port,
                       health_url=app.health_url)
        step(f"{app.name} health")
        wait_health(app)
        after = " ".join(pod_names(app.namespace, f"app={app.deployment}"))
        ok(f"{app.name}: pod {before or '(none)'} → {after or '(none)'}")
    return 0


def cmd_restart(args) -> int:
    step("stop")
    cmd_stop(args)
    step("deploy")
    return cmd_deploy(args)


def cmd_stop(args) -> int:
    state = load_state()
    step("host port-forwards")
    stopped = stop_forwards(state)
    save_state(state)
    ok("; ".join(stopped) if stopped else "none running")

    step(f"cluster container {CLUSTER}")
    for name in (CLUSTER, *LEGACY_CLUSTERS):
        # `podman rm -f` exits 0 for a container that never existed, so ask first what is there.
        if not container_exists(name):
            ok(f"{name} was not running")
            continue
        podman("rm", "-f", name, timeout=120)
        ok(f"{name} removed")

    deadline = time.time() + 60
    while time.time() < deadline:
        if not any(container_exists(name) for name in (CLUSTER, *LEGACY_CLUSTERS)):
            break
        time.sleep(1)
    leftover = [name for name in (CLUSTER, *LEGACY_CLUSTERS) if container_exists(name)]
    if leftover:
        raise Fail(f"{', '.join(leftover)} still exists after podman rm -f")

    ports = (*(app.port for app in APPS.values()), KEYCLOAK_PORT, API_PORT)
    step("ports")
    freed, problems = free_ports(ports)
    if freed:
        ok("; ".join(freed))
    if problems:
        raise Fail("; ".join(problems))
    ok(f"{', '.join(str(port) for port in ports)} free")

    state = empty_state()
    save_state(state)
    for stale in (KUBECONFIG, *LEGACY_KUBECONFIGS, TOKENS_ENV, *LEGACY_TOKEN_FILES):
        if stale.exists():
            stale.unlink()
            ok(f"removed {stale.relative_to(WORKSPACE)}")
    ok(f"state cleared ({STATE_FILE.relative_to(WORKSPACE)})")
    return 0


def cmd_auth(args) -> int:
    auth = load_state().get("auth")
    if args.reuse and tokens_valid(auth):
        ok("tokens reused (still valid)")
        write_tokens_env(auth)
    else:
        auth = mint_tokens()
    for name in APP_ORDER:
        app = APPS[name]
        realm = auth["realms"].get(app.realm)
        if not realm:
            not_configured(app, f"realm {app.realm} has no tokens")
            continue
        print(f"realm {app.realm} ({name}) via {realm['endpoint']}")
        print(f"{'user':<16}{'client':<30}{'scope':<44}{'expires'}")
        for user, _ in app.users:
            entry = realm["tokens"][user]
            print(f"{user:<16}{entry['clientId']:<30}{entry['scope'][:42]:<44}{entry['expiresAt']} (+{entry['expiresIn']}s)")
        print()
    if args.json:
        print(json.dumps(auth, indent=2))
    else:
        print(TOKENS_ENV.read_text().rstrip())
        print(f"\nexports also on disk: {TOKENS_ENV.relative_to(WORKSPACE)}")
    return 0


def warm_up(app: App, token: str) -> None:
    """The suite's first authenticated request is also the app's first JWKS fetch, and Keycloak's first
    realm-key load can outlast the resource server's read timeout: one request of its own, retried."""
    path, _ = app.warmup
    request = urllib.request.Request(f"{app.url}{path}", headers={"Authorization": f"Bearer {token}"})
    for _ in range(4):
        try:
            with urllib.request.urlopen(request, timeout=25) as answer:
                ok(f"{app.name}: JWKS warm ({path} → {answer.status})")
                return
        except urllib.error.HTTPError as failure:
            if failure.code < 500:
                ok(f"{app.name}: JWKS warm ({path} → {failure.code})")
                return
        except (urllib.error.URLError, OSError):
            pass
        time.sleep(2)
    ok(f"{app.name}: warm-up left unanswered — the suite reports the real state")


def cmd_test(args) -> int:
    chosen = targets(args.service)
    for app in chosen:
        if not app.configured:
            raise Fail(
                f"no realm document for {app.name}: looked for {app.realm_document_paths()} — its "
                f"realm is not imported, so its suite cannot authenticate"
            )
    auth = load_state().get("auth")
    if tokens_valid(auth):
        ok("tokens reused (still valid)")
    else:
        step("tokens")
        auth = mint_tokens()

    now = datetime.now(timezone.utc).replace(microsecond=0)
    today = now.date()
    exit_code = 0
    for app in chosen:
        ensure_forward(app.forward, app.namespace, app.port, f"svc/{app.service}", app.service_port,
                       health_url=app.health_url)
        variables = [("BASE_URL", args.base_url or app.url)]
        if app.dates:
            variables += [
                ("availability_future", (today + timedelta(days=30)).isoformat()),
                ("availability_past", (today - timedelta(days=30)).isoformat()),
                ("price_from_future", (now + timedelta(days=30)).isoformat().replace("+00:00", "Z")),
                ("price_until_future", (now + timedelta(days=60)).isoformat().replace("+00:00", "Z")),
            ]
        tokens = auth["realms"][app.realm]["tokens"]
        variables += [(variable, tokens[user]["token"]) for variable, user in app.variables]
        warm_up(app, tokens[app.warmup[1]]["token"])

        suite = Path(args.suite) if args.suite else app.directory / app.suite
        if not suite.is_absolute():
            suite = app.directory / suite
        if not suite.exists():
            raise Fail(f"suite not found: {suite}")

        command = ["hurl", "--test", "--max-time", "30"]
        for variable, value in variables:
            command += ["--variable", f"{variable}={value}"]
        command.append(str(suite))

        step(f"{app.name}: hurl --test {suite.relative_to(app.directory)} against {args.base_url or app.url}")
        completed = run(command, cwd=app.directory, timeout=T_HURL, check=False)
        output = (completed.stdout or "") + (completed.stderr or "")
        print(output.rstrip(), flush=True)
        requests = re.search(r"Executed requests:\s*(\d+)", output) or re.search(r"Requests:\s*(\d+)", output)
        files = re.search(r"Executed files:\s*(\d+)", output)
        print(f"\nexit code {completed.returncode}; "
              f"requests {requests.group(1) if requests else '?'}; "
              f"files {files.group(1) if files else '?'}")
        exit_code = exit_code or completed.returncode
    return exit_code


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="run-apps", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)

    deploy = commands.add_parser("deploy", help="create/reuse the cluster, install infra, build, import, roll out")
    deploy.add_argument("service", nargs="?", choices=APP_ORDER, help="one service; omit for both")
    deploy.add_argument("--force-build", action="store_true", help="rebuild the image even when nothing changed")
    deploy.add_argument("--skip-build", action="store_true", help="reuse build/jib-image.tar without running Gradle")
    deploy.set_defaults(handler=cmd_deploy)

    status = commands.add_parser("status", help="cluster, both services' pods, health, host bridges")
    status.add_argument("--json", action="store_true")
    status.set_defaults(handler=cmd_status)

    logs = commands.add_parser("logs", help="bounded logs of one pod, one service or every app pod")
    logs.add_argument("pod", nargs="?", help=f"pod name or one of {', '.join(APP_ORDER)}; omit for every app pod")
    logs.add_argument("--tail", type=int, default=200)
    logs.add_argument("--since", default=None, help="kubectl --since, e.g. 10m")
    logs.add_argument("--follow", action="store_true", help="stream (Ctrl-C to stop) — opt-in only")
    logs.add_argument("--infra", action="store_true", help="with no pod argument, show the shared infra pods")
    logs.set_defaults(handler=cmd_logs)

    rebuild = commands.add_parser("rebuild", help="jibBuildTar → import → rollout restart → wait Ready")
    rebuild.add_argument("service", nargs="?", choices=APP_ORDER, help="one service; omit for both, in order")
    rebuild.set_defaults(handler=cmd_rebuild)

    restart = commands.add_parser("restart", help="stop then deploy")
    restart.add_argument("service", nargs="?", choices=APP_ORDER, help="one service; omit for both")
    restart.add_argument("--skip-build", action="store_true")
    restart.add_argument("--force-build", action="store_true")
    restart.set_defaults(handler=cmd_restart)

    stop = commands.add_parser("stop", help="delete the cluster, kill port-forwards, free the ports")
    stop.set_defaults(handler=cmd_stop)

    auth = commands.add_parser("auth", help="mint the scoped tokens of both realms from the in-cluster Keycloak")
    auth.add_argument("--json", action="store_true")
    auth.add_argument("--reuse", action="store_true", help="keep the tokens on disk when they are still valid")
    auth.set_defaults(handler=cmd_auth)

    test = commands.add_parser("test", help="run a service's hurl suite against the cluster")
    test.add_argument("service", nargs="?", choices=APP_ORDER, help="one service; omit for both, in order")
    test.add_argument("--suite", default=None, help="suite path relative to the service, overriding the default")
    test.add_argument("--base-url", default=None, help="override the service's host URL")
    test.set_defaults(handler=cmd_test)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args)
    except Fail as failure:
        print(f"error: {failure}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
