#!/usr/bin/env python3
"""run-apps — the shop-wide local k3s environment, with the catalog service as its first tenant.

The cluster (`shop-k3s`, k3s in a privileged podman container) and the Postgres instance
(`postgresql`) are shop-wide: one server, one superuser secret, one logical database per service
(from `databases.txt` in manifests/infra/postgres.yaml). Kafka, Keycloak with the `catalog` realm,
the catalog image built by Jib, and one host port-forward that makes the service reachable at
http://127.0.0.1:8080 stay per service.

Every command is idempotent and bounded: no `kubectl logs -f`, no `kubectl get -w`, every wait carries
a timeout and on timeout prints the state it timed out on. Managed host-side processes (the
port-forwards) are recorded in .agents/runtime/processes.json.
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import re
import signal
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
WORKSPACE = SKILL_DIR.parents[2]
SERVICE = WORKSPACE / "services/catalog"
MANIFESTS = SKILL_DIR / "manifests"
RUNTIME = WORKSPACE / ".agents/runtime"
STATE_FILE = RUNTIME / "processes.json"
KUBECONFIG = RUNTIME / "kubeconfig-shop.yaml"
LOG_DIR = RUNTIME / "logs"

CLUSTER = "shop-k3s"
# Before the shop-wide rename the cluster was per service. A machine that still carries the old one
# must never end up with two clusters: `deploy` and `stop` reuse this list.
LEGACY_CLUSTERS = ("catalog-k3s",)
LEGACY_KUBECONFIGS = (RUNTIME / "kubeconfig-catalog.yaml",)
NAMESPACE = "catalog"
POSTGRES = "postgresql"
K3S_IMAGE = "docker.io/rancher/k3s:v1.35.5-k3s1"
API_PORT = 6443
APP_PORT = 8080
KEYCLOAK_PORT = 18081
APP_IMAGE = "catalog:latest"
APP_DEPLOYMENT = "catalog"
APP_SUITE = SERVICE / "e2e/catalog-http-api.hurl"
REALM = "catalog"
REALM_DOCUMENT = SERVICE / "src/test/resources/catalog-realm.json"
USERS = ("author", "reviewer", "photographer", "sales")
INFRA_DEPLOYMENTS = (POSTGRES, "kafka", "keycloak")

T_NODE_READY = 180
T_ROLLOUT = 420
T_HEALTH = 180
T_FORWARD = 90
T_BUILD = 1800
T_HURL = 1800


class Fail(Exception):
    """A step that cannot continue: the message is the diagnostic the operator needs."""


# ── process plumbing ──────────────────────────────────────────────────────────────────────────────


def tail(text: str, lines: int = 25) -> str:
    kept = [line for line in (text or "").splitlines() if line.strip()][-lines:]
    return "\n".join(kept)


def run(cmd, *, cwd=None, timeout=120, check=True, stdin=None, input=None):
    args = [str(c) for c in cmd]
    try:
        done = subprocess.run(
            args,
            cwd=str(cwd) if cwd else None,
            timeout=timeout,
            stdin=stdin,
            input=input,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as missing:
        raise Fail(f"{args[0]} is not installed: {missing}") from missing
    except subprocess.TimeoutExpired as expired:
        raise Fail(f"timed out after {timeout}s: {' '.join(args)}") from expired
    if check and done.returncode != 0:
        raise Fail(
            f"command failed with exit {done.returncode}: {' '.join(args)}\n{tail((done.stdout or '') + (done.stderr or ''))}"
        )
    return done


def step(name: str) -> None:
    print(f"==> {name}", flush=True)


def ok(message: str) -> None:
    print(f"    {message}", flush=True)


# ── state ────────────────────────────────────────────────────────────────────────────────────────


def empty_state() -> dict:
    return {
        "version": 1,
        "cluster": None,
        "hostProcesses": {},
        "services": {APP_DEPLOYMENT: {"image": APP_IMAGE}},
        "auth": None,
        "updatedAt": None,
    }


def load_state() -> dict:
    if not STATE_FILE.exists():
        return empty_state()
    try:
        state = json.loads(STATE_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return empty_state()
    base = empty_state()
    base.update(state)
    return base


def save_state(state: dict) -> None:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    state["updatedAt"] = now_iso()
    tmp = STATE_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(STATE_FILE)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ── podman / kubectl ─────────────────────────────────────────────────────────────────────────────


def podman(*args, **kwargs):
    return run(["podman", *args], **kwargs)


def kubectl(*args, **kwargs):
    return run(["kubectl", "--kubeconfig", KUBECONFIG, *args], **kwargs)


def podman_reachable() -> bool:
    return podman("info", "--format", "{{.Host.Arch}}", check=False, timeout=60).returncode == 0


def ensure_machine() -> None:
    if podman_reachable():
        ok("podman machine reachable")
        return
    print("    podman machine not reachable — starting it", flush=True)
    started = podman("machine", "start", check=False, timeout=300)
    if started.returncode != 0 or not podman_reachable():
        raise Fail(f"podman machine cannot start:\n{tail((started.stdout or '') + (started.stderr or ''))}")
    ok("podman machine started")


def cluster_container() -> dict | None:
    if not podman_reachable():
        return None
    found = podman(
        "inspect", "--format", "{{.State.Running}}|{{.State.Status}}|{{.ImageName}}|{{.State.StartedAt}}",
        CLUSTER, check=False, timeout=60,
    )
    if found.returncode != 0:
        return None
    running, status, image, started = (found.stdout.strip().split("|") + ["", "", "", ""])[:4]
    return {"running": running == "true", "status": status, "image": image, "startedAt": started}


def ensure_cluster() -> None:
    container = cluster_container()
    if container and container["running"]:
        ok(f"cluster container {CLUSTER} already running")
        return
    if container:
        podman("start", CLUSTER, timeout=180)
        ok(f"cluster container {CLUSTER} restarted")
        return
    local = podman("images", "--format", "{{.Repository}}:{{.Tag}}", K3S_IMAGE, check=False, timeout=60)
    if K3S_IMAGE not in local.stdout.split():
        print(f"    pulling {K3S_IMAGE}", flush=True)
        podman("pull", K3S_IMAGE, timeout=900)
    podman(
        "run", "-d", "--name", CLUSTER, "--privileged", "--hostname", "k3s",
        "-p", f"{API_PORT}:6443",
        K3S_IMAGE, "server",
        "--disable=traefik", "--disable=servicelb", "--disable=metrics-server",
        "--write-kubeconfig-mode=644", "--tls-san=127.0.0.1",
        # The podman machine is a shared 100 GiB disk that other work also fills. k3s defaults to
        # evicting at 5 % free (5 GiB here), which is more than these five pods can ever use; a 1 GiB
        # floor still leaves the node honest about a genuinely full disk without evicting the stack.
        "--kubelet-arg=eviction-hard=imagefs.available<1Gi,nodefs.available<1Gi",
        timeout=180,
    )
    ok(f"cluster container {CLUSTER} created (image {K3S_IMAGE}, api 127.0.0.1:{API_PORT})")


def container_exists(name: str) -> bool:
    if not podman_reachable():
        return False
    return podman("container", "exists", name, check=False, timeout=60).returncode == 0


def reclaim_legacy() -> None:
    """A stopped `catalog-k3s` from the per-service layout is announced and removed, never left beside
    the shop-wide cluster."""
    step(f"legacy layout ({', '.join(LEGACY_CLUSTERS)})")
    reclaimed = []
    for name in LEGACY_CLUSTERS:
        if not container_exists(name):
            continue
        print(f"    {name} is the per-service cluster of the old layout, replaced by {CLUSTER} — removing it", flush=True)
        podman("rm", "-f", name, check=False, timeout=120)
        if container_exists(name):
            raise Fail(f"the legacy cluster container {name} cannot be removed; free it with `podman rm -f {name}`")
        reclaimed.append(name)
    for stale in LEGACY_KUBECONFIGS:
        if stale.exists():
            stale.unlink()
            reclaimed.append(str(stale.relative_to(WORKSPACE)))
    ok(f"removed {', '.join(reclaimed)}" if reclaimed else f"none, {CLUSTER} is the only cluster")


def write_kubeconfig() -> None:
    """k3s writes its kubeconfig only after the API server starts, so the read is bounded."""
    RUNTIME.mkdir(parents=True, exist_ok=True)
    deadline = time.time() + T_NODE_READY
    document = ""
    while time.time() < deadline:
        found = podman("exec", CLUSTER, "cat", "/etc/rancher/k3s/k3s.yaml", check=False, timeout=60)
        if found.returncode == 0 and "server:" in (found.stdout or ""):
            document = found.stdout
            break
        state = cluster_container()
        if state and not state["running"]:
            logs = podman("logs", "--tail", "20", CLUSTER, check=False, timeout=30)
            raise Fail(f"cluster container {CLUSTER} exited while starting\n{tail((logs.stdout or '') + (logs.stderr or ''))}")
        time.sleep(2)
    if not document:
        raise Fail(f"{CLUSTER} did not write /etc/rancher/k3s/k3s.yaml within {T_NODE_READY}s")
    document = document.replace("server: https://127.0.0.1:6443", f"server: https://127.0.0.1:{API_PORT}")
    for field, value in (
        ("name: default", f"name: {CLUSTER}"),
        ("cluster: default", f"cluster: {CLUSTER}"),
        ("user: default", f"user: {CLUSTER}"),
        ("current-context: default", f"current-context: {CLUSTER}"),
    ):
        document = document.replace(field, value)
    KUBECONFIG.write_text(document)
    os.chmod(KUBECONFIG, 0o600)
    ok(f"kubeconfig {KUBECONFIG.relative_to(WORKSPACE)} (context {CLUSTER})")


def node_state() -> tuple[str | None, str]:
    if not KUBECONFIG.exists():
        return None, "kubeconfig absent"
    found = kubectl(
        "get", "nodes", "--no-headers",
        "-o", "custom-columns=NAME:.metadata.name,READY:.status.conditions[?(@.type=='Ready')].status",
        check=False, timeout=30,
    )
    if found.returncode != 0:
        return None, tail((found.stdout or "") + (found.stderr or ""), 5)
    for line in found.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "True":
            return parts[0], "Ready"
    return None, "no node reports Ready=True"


def wait_node_ready(timeout: int = T_NODE_READY) -> None:
    deadline = time.time() + timeout
    detail = ""
    while time.time() < deadline:
        node, detail = node_state()
        if node:
            ok(f"node {node} Ready")
            return
        time.sleep(2)
    logs = podman("logs", "--tail", "20", CLUSTER, check=False, timeout=30)
    raise Fail(f"node not Ready after {timeout}s ({detail})\n{tail((logs.stdout or '') + (logs.stderr or ''))}")


def rollout_status(deployment: str, timeout: int = T_ROLLOUT) -> None:
    done = kubectl(
        "-n", NAMESPACE, "rollout", "status", f"deployment/{deployment}",
        f"--timeout={timeout}s", check=False, timeout=timeout + 30,
    )
    if done.returncode != 0:
        raise Fail(f"deployment/{deployment} did not become Ready\n{diagnose(deployment)}")
    ok(f"deployment/{deployment} Ready")


def disk_free_gib() -> float | None:
    found = podman("exec", CLUSTER, "df", "-Pk", "/", check=False, timeout=30)
    lines = (found.stdout or "").splitlines()
    if len(lines) < 2:
        return None
    fields = lines[1].split()
    if len(fields) < 4 or not fields[3].isdigit():
        return None
    return int(fields[3]) / (1024 * 1024)


def check_disk() -> None:
    """k3s evicts every pod under disk pressure, which reads as an unexplained rollout timeout."""
    free = disk_free_gib()
    if free is None:
        return
    if free < 3:
        raise Fail(
            f"the podman machine disk has {free:.1f} GiB free — k3s will evict every pod under disk pressure.\n"
            f"Free space first: `podman image prune -f`, then `podman system df` and `podman volume ls`."
        )
    if free < 8:
        print(f"    warning: {free:.1f} GiB free on the podman machine disk", flush=True)


def node_conditions() -> str:
    found = kubectl("get", "node", "-o", "wide", check=False, timeout=30)
    return tail(found.stdout or "", 5)


def diagnose(deployment: str) -> str:
    parts = [node_conditions()]
    pods = kubectl("-n", NAMESPACE, "get", "pods", "-l", f"app={deployment}", "-o", "wide", check=False, timeout=30)
    parts.append(tail(pods.stdout or "", 10))
    for pod in pod_names(f"app={deployment}"):
        described = kubectl("-n", NAMESPACE, "describe", "pod", pod, check=False, timeout=30)
        events = [line for line in (described.stdout or "").splitlines() if line.startswith("  ") and ":" in line]
        parts.append(f"--- {pod} events ---\n" + tail("\n".join(events), 12))
        logged = kubectl("-n", NAMESPACE, "logs", pod, "--tail", "30", check=False, timeout=60)
        parts.append(f"--- {pod} logs ---\n" + tail((logged.stdout or "") + (logged.stderr or ""), 30))
    return "\n".join(p for p in parts if p.strip())


def pod_names(selector: str) -> list[str]:
    found = kubectl("-n", NAMESPACE, "get", "pods", "-l", selector, "-o", "jsonpath={.items[*].metadata.name}",
                    check=False, timeout=30)
    return (found.stdout or "").split()


def pod_phase(selector: str) -> str:
    found = kubectl("-n", NAMESPACE, "get", "pods", "-l", selector, "-o",
                    "jsonpath={.items[*].status.phase}", check=False, timeout=30)
    return " ".join((found.stdout or "").split())


# ── http ────────────────────────────────────────────────────────────────────────────────────────


def http_get(url: str, timeout: int = 5) -> tuple[int, str]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as answer:
            return answer.status, answer.read(400).decode("utf-8", "replace")
    except urllib.error.HTTPError as failure:
        return failure.code, failure.read(400).decode("utf-8", "replace")
    except (urllib.error.URLError, OSError) as unreachable:
        return 0, str(unreachable)


def health() -> tuple[bool, str]:
    status, body = http_get(f"http://127.0.0.1:{APP_PORT}/actuator/health")
    try:
        verdict = json.loads(body).get("status", "")
    except json.JSONDecodeError:
        verdict = ""
    return (status == 200 and verdict == "UP"), f"{status} {verdict}".strip()


def answers(url: str, timeout: int = 15) -> bool:
    """A port-forward survives a rollout but drops its connection for a moment; give it that moment."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if http_get(url)[0] in (200, 401):
            return True
        time.sleep(1)
    return False


def wait_health(timeout: int = T_HEALTH) -> None:
    deadline = time.time() + timeout
    last = ""
    while time.time() < deadline:
        healthy, last = health()
        if healthy:
            ok(f"GET /actuator/health → {last} on http://127.0.0.1:{APP_PORT}")
            return
        time.sleep(3)
    raise Fail(f"health not UP after {timeout}s (last {last or 'no answer'})\n{diagnose(APP_DEPLOYMENT)}")


# ── host-side port-forwards ────────────────────────────────────────────────────────────────────


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except (OSError, ValueError):
        return False
    return True


def terminate(pid: int, timeout: int = 10) -> None:
    if not pid_alive(pid):
        return
    try:
        os.killpg(os.getpgid(pid), signal.SIGTERM)
    except OSError:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            return
    deadline = time.time() + timeout
    while time.time() < deadline and pid_alive(pid):
        time.sleep(0.2)
    if pid_alive(pid):
        try:
            os.killpg(os.getpgid(pid), signal.SIGKILL)
        except OSError:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass


def forward_orphans() -> list[int]:
    """kubectl port-forwards of this workspace that the state file forgot."""
    found = run(["ps", "-Ao", "pid=,command="], check=False, timeout=30)
    pids = []
    for line in (found.stdout or "").splitlines():
        line = line.strip()
        if "port-forward" not in line or "kubectl" not in line:
            continue
        if str(KUBECONFIG) not in line and not any(str(old) in line for old in LEGACY_KUBECONFIGS):
            continue
        try:
            pids.append(int(line.split(None, 1)[0]))
        except ValueError:
            continue
    return pids


def stop_forwards(state: dict) -> list[str]:
    stopped = []
    for name, entry in list(state["hostProcesses"].items()):
        terminate(int(entry.get("pid", 0)))
        stopped.append(f"{name} (pid {entry.get('pid')})")
        state["hostProcesses"].pop(name, None)
    for pid in forward_orphans():
        terminate(pid)
        stopped.append(f"orphan port-forward (pid {pid})")
    return stopped


def ensure_forward(name: str, local: int, target: str, remote: int, health_url: str | None = None) -> dict:
    state = load_state()
    entry = state["hostProcesses"].get(name)
    if entry and pid_alive(int(entry["pid"])):
        if health_url is None or answers(health_url):
            ok(f"{name}: http://127.0.0.1:{local} → {target}:{remote} already up (pid {entry['pid']})")
            return entry
        print(f"    {name} on {local} is alive but not answering for 15s — restarting it", flush=True)
        terminate(int(entry["pid"]))
        state["hostProcesses"].pop(name, None)
    elif entry:
        state["hostProcesses"].pop(name, None)

    for pid in port_listeners(local):
        raise Fail(f"host port {local} is already taken by pid {pid} ({process_command(pid)}); run `run-apps stop`")

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"port-forward-{name}.log"
    handle = open(log_path, "wb")
    process = subprocess.Popen(
        ["kubectl", "--kubeconfig", str(KUBECONFIG), "-n", NAMESPACE, "port-forward", target, f"{local}:{remote}"],
        stdout=handle, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True,
    )
    handle.close()
    entry = {
        "pid": process.pid,
        "localPort": local,
        "target": target,
        "remotePort": remote,
        "url": f"http://127.0.0.1:{local}",
        "log": str(log_path.relative_to(WORKSPACE)),
        "startedAt": now_iso(),
    }
    state["hostProcesses"][name] = entry
    save_state(state)

    deadline = time.time() + T_FORWARD
    while time.time() < deadline:
        if process.poll() is not None:
            raise Fail(f"port-forward {target} → {local} exited\n{tail(log_path.read_text(errors='replace'))}")
        if health_url and http_get(health_url)[0] in (200, 401):
            ok(f"{name}: http://127.0.0.1:{local} → {target}:{remote} (pid {process.pid})")
            return entry
        if health_url is None:
            ok(f"{name}: http://127.0.0.1:{local} → {target}:{remote} (pid {process.pid})")
            return entry
        time.sleep(1)
    raise Fail(f"port-forward {target} → {local} did not answer within {T_FORWARD}s\n{tail(log_path.read_text(errors='replace'))}")


# ── ports ──────────────────────────────────────────────────────────────────────────────────────


def port_listeners(port: int) -> list[int]:
    found = run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], check=False, timeout=20)
    return [int(value) for value in (found.stdout or "").split() if value.isdigit()]


def process_command(pid: int) -> str:
    found = run(["ps", "-o", "command=", "-p", str(pid)], check=False, timeout=20)
    return tail(found.stdout or "", 1)


def free_ports(ports: tuple[int, ...]) -> tuple[list[str], list[str]]:
    """Kill leftover port-forwards on our ports; never touch a process that is something else."""
    freed, problems = [], []
    for port in ports:
        for pid in port_listeners(port):
            command = process_command(pid)
            if "port-forward" in command and "kubectl" in command:
                terminate(pid)
                freed.append(f"port {port}: killed port-forward pid {pid}")
            else:
                problems.append(f"port {port} held by pid {pid} ({command}) — not a port-forward, not killing it")
    for port in ports:
        if port_listeners(port) and not any(problem.startswith(f"port {port} ") for problem in problems):
            problems.append(f"port {port} still held by {', '.join(map(str, port_listeners(port)))} after SIGKILL")
    return freed, problems


# ── infra and app manifests ───────────────────────────────────────────────────────────────────


def ensure_namespace() -> None:
    document = kubectl("create", "namespace", NAMESPACE, "--dry-run=client", "-o", "yaml", timeout=30).stdout
    kubectl("apply", "-f", "-", input=document, timeout=60)


def ensure_realm_configmap() -> None:
    if not REALM_DOCUMENT.exists():
        raise Fail(f"the realm document is missing: {REALM_DOCUMENT}")
    rendered = kubectl(
        "-n", NAMESPACE, "create", "configmap", "keycloak-realm",
        f"--from-file=catalog-realm.json={REALM_DOCUMENT}", "--dry-run=client", "-o", "yaml", timeout=60,
    )
    kubectl("apply", "-f", "-", input=rendered.stdout, timeout=60)
    ok(f"realm {REALM} from {REALM_DOCUMENT.relative_to(WORKSPACE)}")


def apply_infra() -> None:
    ensure_namespace()
    ensure_realm_configmap()
    kubectl("apply", "-f", MANIFESTS / "infra", timeout=120)
    ok("manifests/infra applied (postgresql with one database per service, kafka, keycloak)")


def app_manifest() -> str:
    return kubectl("kustomize", "--load-restrictor", "LoadRestrictionsNone", MANIFESTS / "app", timeout=120).stdout


def apply_app() -> None:
    rendered = app_manifest()
    kubectl("apply", "-f", "-", input=rendered, timeout=120)
    ok("service overlay applied (overlays/k3d + catalog realm issuer + otel collector)")


# ── image pipeline ────────────────────────────────────────────────────────────────────────────


def node_architecture() -> str:
    """The arch the node runs, which is the arch the image must have. Jib defaults to linux/amd64."""
    found = kubectl("get", "nodes", "--no-headers", "-o",
                    "jsonpath={.items[0].status.nodeInfo.architecture}", check=False, timeout=30)
    arch = (found.stdout or "").strip()
    if arch:
        return "amd64" if arch == "x86_64" else arch
    machine = platform.machine().lower()
    return "amd64" if machine in ("x86_64", "amd64") else "arm64"


def tar_architecture(tar: Path) -> str:
    try:
        with tarfile.open(tar) as archive:
            manifest = json.load(archive.extractfile("manifest.json"))
            config = json.load(archive.extractfile(manifest[0]["Config"]))
            return config.get("architecture", "")
    except (KeyError, IndexError, OSError, json.JSONDecodeError, tarfile.TarError):
        return ""


def newest_source_mtime() -> float:
    newest = 0.0
    for root in (SERVICE / "src", SERVICE / "config"):
        for path in root.rglob("*"):
            if path.is_file():
                newest = max(newest, path.stat().st_mtime)
    for path in (SERVICE / "build.gradle", SERVICE / "settings.gradle"):
        if path.exists():
            newest = max(newest, path.stat().st_mtime)
    return newest


def cluster_images() -> str:
    if not cluster_container():
        return ""
    found = podman("exec", CLUSTER, "ctr", "-n", "k8s.io", "images", "ls", "-q", check=False, timeout=120)
    return found.stdout or ""


def cluster_has_app_image() -> bool:
    return bool(re.search(r"(^|/)catalog:latest$", cluster_images(), re.MULTILINE))


def build_image(force: bool, skip_build: bool) -> tuple[Path, bool]:
    """Returns the tar and whether it was built by this call."""
    tar = SERVICE / "build/jib-image.tar"
    arch = node_architecture()
    target = f"linux/{arch}"
    if tar.exists() and tar_architecture(tar) != arch:
        print(f"    {tar.name} is {tar_architecture(tar) or 'unknown'}, the node is {target} — rebuilding", flush=True)
        skip_build = False
    if skip_build:
        if not tar.exists():
            raise Fail(f"--skip-build was asked for but {tar} does not exist")
        ok(f"image tar reused (--skip-build, {target})")
        return tar, False
    if not force and tar.exists() and tar.stat().st_mtime >= newest_source_mtime():
        ok(f"image tar up to date ({target}, {tar.stat().st_size // (1024 * 1024)} MiB)")
        return tar, False
    print(f"    ./gradlew jibBuildTar -Djib.from.platforms={target}", flush=True)
    built = run(
        ["./gradlew", "jibBuildTar", f"-Djib.from.platforms={target}", "--console=plain"],
        cwd=SERVICE, timeout=T_BUILD, check=False,
    )
    if built.returncode != 0:
        raise Fail(f"jibBuildTar failed with exit {built.returncode}\n{tail((built.stdout or '') + (built.stderr or ''), 40)}")
    if not tar.exists():
        raise Fail(f"jibBuildTar reported success but {tar} does not exist")
    if tar_architecture(tar) != arch:
        raise Fail(f"{tar} is {tar_architecture(tar) or 'unknown'} but the node runs {target}; "
                   f"Jib was not switched by -Djib.from.platforms")
    ok(f"image tar built ({target}, {tar.stat().st_size // (1024 * 1024)} MiB)")
    return tar, True


def import_image(tar: Path) -> None:
    with open(tar, "rb") as image:
        imported = podman(
            "exec", "-i", CLUSTER, "ctr", "-n", "k8s.io", "images", "import", "-",
            stdin=image, check=False, timeout=600,
        )
    if imported.returncode != 0:
        raise Fail(f"ctr images import failed with exit {imported.returncode}\n{tail((imported.stdout or '') + (imported.stderr or ''))}")
    if not cluster_has_app_image():
        raise Fail(f"{APP_IMAGE} is not in the cluster image store after the import")
    ok(f"{APP_IMAGE} imported into k3s containerd")


def restart_deployment(deployment: str) -> None:
    kubectl("-n", NAMESPACE, "rollout", "restart", f"deployment/{deployment}", timeout=60)
    rollout_status(deployment)


# ── auth ──────────────────────────────────────────────────────────────────────────────────────


def ensure_keycloak_forward() -> None:
    ensure_forward("keycloak", KEYCLOAK_PORT, "svc/catalog-keycloak", 8080,
                   health_url=f"http://127.0.0.1:{KEYCLOAK_PORT}/realms/{REALM}")


def mint_tokens() -> dict:
    if not cluster_container() or not cluster_container()["running"]:
        raise Fail("the cluster is not running — `run-apps deploy` first")
    if pod_phase("app=keycloak") != "Running":
        raise Fail(f"keycloak is not Running (phase: {pod_phase('app=keycloak') or 'absent'}) — `run-apps deploy` first")
    ensure_keycloak_forward()

    endpoint = f"http://127.0.0.1:{KEYCLOAK_PORT}/realms/{REALM}/protocol/openid-connect/token"
    tokens = {}
    for user in USERS:
        payload = urllib.parse.urlencode({
            "grant_type": "password",
            "client_id": f"catalog-{user}-client",
            "client_secret": "secret",
            "username": user,
            "password": user,
            "scope": "openid",
        }).encode()
        request = urllib.request.Request(endpoint, data=payload,
                                         headers={"Content-Type": "application/x-www-form-urlencoded"})
        try:
            with urllib.request.urlopen(request, timeout=20) as answer:
                body = json.loads(answer.read())
        except urllib.error.HTTPError as failure:
            raise Fail(f"keycloak refused the password grant for {user}: {failure.code} {failure.read(400).decode('utf-8', 'replace')}") from failure
        except (urllib.error.URLError, OSError) as unreachable:
            raise Fail(f"keycloak is not reachable at {endpoint}: {unreachable}") from unreachable
        issued = datetime.now(timezone.utc)
        tokens[user] = {
            "token": body["access_token"],
            "scope": body.get("scope", ""),
            "clientId": f"catalog-{user}-client",
            "issuedAt": issued.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "expiresAt": (issued + timedelta(seconds=int(body.get("expires_in", 3600)))).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "expiresIn": int(body.get("expires_in", 3600)),
        }
    # Reload first: the port-forward started above was recorded in the state file after this
    # command began, and a save from the older copy would drop it.
    state = load_state()
    state["auth"] = {"realm": REALM, "endpoint": endpoint, "issuedAt": now_iso(), "tokens": tokens}
    save_state(state)

    env_file = RUNTIME / "catalog-tokens.env"
    env_file.write_text("".join(f"export {user.upper()}_TOKEN='{tokens[user]['token']}'\n" for user in USERS))
    os.chmod(env_file, 0o600)
    return state["auth"]


def tokens_valid(auth: dict | None) -> bool:
    if not auth or not auth.get("tokens"):
        return False
    for user in USERS:
        entry = auth["tokens"].get(user)
        if not entry:
            return False
        expires = datetime.strptime(entry["expiresAt"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        if expires - datetime.now(timezone.utc) < timedelta(seconds=60):
            return False
    return True


# ── commands ─────────────────────────────────────────────────────────────────────────────────


def cmd_deploy(args) -> int:
    step("podman machine")
    ensure_machine()
    reclaim_legacy()
    step(f"cluster {CLUSTER}")
    ensure_cluster()
    state = load_state()
    state["cluster"] = {
        "name": CLUSTER,
        "container": CLUSTER,
        "image": K3S_IMAGE,
        "apiPort": API_PORT,
        "kubeconfig": str(KUBECONFIG.relative_to(WORKSPACE)),
        "context": CLUSTER,
        "startedAt": (cluster_container() or {}).get("startedAt"),
    }
    save_state(state)
    step("kubeconfig")
    write_kubeconfig()
    step("node readiness")
    wait_node_ready()
    check_disk()
    step("infra manifests")
    apply_infra()
    step("infra readiness")
    for deployment in INFRA_DEPLOYMENTS:
        rollout_status(deployment)
    step("image")
    tar, built = build_image(force=args.force_build, skip_build=args.skip_build)
    if built or args.force_build or not cluster_has_app_image():
        import_image(tar)
    else:
        ok(f"cluster already carries {APP_IMAGE}")
    step("app manifests")
    apply_app()
    step("app rollout")
    rollout_status(APP_DEPLOYMENT)
    step("host port-forward")
    ensure_forward("catalog-app", APP_PORT, "svc/catalog", 80, health_url=f"http://127.0.0.1:{APP_PORT}/actuator/health")
    step("health")
    wait_health()
    print("\nThe catalog API is at http://127.0.0.1:8080 — `run-apps status`, `run-apps auth`, `run-apps test`.")
    return 0


def postgres_databases() -> list[str]:
    """The logical databases the shop-wide instance carries — one per service, from databases.txt."""
    found = kubectl(
        "-n", NAMESPACE, "exec", f"deploy/{POSTGRES}", "--",
        "psql", "-U", "postgres", "-d", "postgres", "-tAc",
        "SELECT datname FROM pg_database WHERE datname NOT LIKE 'template%' AND datname <> 'postgres' ORDER BY 1",
        check=False, timeout=30,
    )
    return (found.stdout or "").split() if found.returncode == 0 else []


def cmd_status(args) -> int:
    state = load_state()
    report = {
        "podmanMachine": podman_reachable(),
        "clusterContainer": cluster_container(),
        "legacyContainers": [],
        "databases": [],
        "node": None,
        "pods": "", "services": "", "deployments": "", "endpoints": "",
        "hostProcesses": [], "appHealth": (False, "cluster down"),
    }
    if report["podmanMachine"]:
        report["legacyContainers"] = [name for name in LEGACY_CLUSTERS if container_exists(name)]
    if report["clusterContainer"] and report["clusterContainer"]["running"]:
        report["node"] = node_state()[0]
        report["databases"] = postgres_databases()
        for key, query in (
            ("pods", ("get", "pods", "-o", "wide")),
            ("services", ("get", "services", "-o", "wide")),
            ("endpoints", ("get", "endpoints")),
            ("deployments", ("get", "deployments")),
        ):
            found = kubectl("-n", NAMESPACE, *query, check=False, timeout=60)
            report[key] = found.stdout if found.returncode == 0 else tail((found.stdout or "") + (found.stderr or ""), 5)
        for name, entry in state["hostProcesses"].items():
            alive = pid_alive(int(entry["pid"]))
            healthy, detail = (False, "not answering")
            if alive:
                healthy, detail = health() if name == "catalog-app" else (http_get(f"{entry['url']}/realms/{REALM}")[0] == 200, "200")
            report["hostProcesses"].append({**entry, "alive": alive, "healthy": healthy, "detail": detail})
        report["appHealth"] = health()
    if not isinstance(report["appHealth"], tuple):
        report["appHealth"] = (False, "unknown")

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        container = report["clusterContainer"]
        print("== runtime ==")
        print(f"podman machine      {'UP' if report['podmanMachine'] else 'DOWN'}")
        if container:
            print(f"cluster container   {CLUSTER} {'RUNNING' if container['running'] else container['status'].upper()} "
                  f"({K3S_IMAGE}, api 127.0.0.1:{API_PORT})")
        else:
            print(f"cluster container   {CLUSTER} ABSENT")
        print(f"node                {report['node'] or 'none Ready'}")
        print(f"kubeconfig          {KUBECONFIG.relative_to(WORKSPACE) if KUBECONFIG.exists() else 'absent'}")
        if report["clusterContainer"] and report["clusterContainer"]["running"]:
            print(f"databases           {', '.join(report['databases']) or 'unreachable'} (instance {POSTGRES})")
        else:
            print(f"databases           n/a — cluster down (instance {POSTGRES})")
        for legacy in report["legacyContainers"]:
            print(f"legacy container    {legacy} PRESENT — the old per-service cluster; `run-apps deploy` removes it")

        for title, key in (("workloads", "pods"), ("deployments", "deployments"),
                           ("services", "services"), ("endpoints", "endpoints")):
            print(f"\n== {title} ({NAMESPACE}) ==")
            print((report[key] or "(none)").rstrip())

        print("\n== host bridges ==")
        if not report["hostProcesses"]:
            print("(none)")
        for entry in report["hostProcesses"]:
            print(f"{entry['url']:<28} -> {entry['target']}:{entry['remotePort']}  "
                  f"{'LIVE ' if entry['alive'] else 'DEAD '} pid {entry['pid']}  "
                  f"{'healthy' if entry['healthy'] else entry['detail']}")

        healthy, detail = report["appHealth"]
        print("\n== verdict ==")
        deploy_ready = re.search(rf"{APP_DEPLOYMENT}\s+1/1", report["deployments"] or "") is not None
        green = (bool(container and container["running"]) and bool(report["node"]) and healthy and deploy_ready)
        if green:
            print(f"GREEN — cluster up, {APP_DEPLOYMENT} 1/1, GET /actuator/health → {detail}")
        else:
            print(f"RED — cluster {'up' if container and container['running'] else 'down'}, "
                  f"node {report['node'] or 'not Ready'}, {APP_DEPLOYMENT} {'1/1' if deploy_ready else 'not Ready'}, "
                  f"health {detail}")
    green = (bool(report["clusterContainer"] and report["clusterContainer"]["running"])
             and bool(report["node"]) and report["appHealth"] and report["appHealth"][0]
             and re.search(rf"{APP_DEPLOYMENT}\s+1/1", report["deployments"] or "") is not None)
    return 0 if green else 1


def cmd_logs(args) -> int:
    if not cluster_container() or not cluster_container()["running"]:
        raise Fail("the cluster is not running — `run-apps deploy` first")
    if args.pod:
        pods = [args.pod]
    else:
        if args.infra:
            selector = f"app in ({POSTGRES},kafka,keycloak,otel-collector)"
        else:
            selector = f"app={APP_DEPLOYMENT}"
        pods = pod_names(selector)
        if not pods:
            raise Fail(f"no pod matches {selector} in namespace {NAMESPACE}")
    print(f"logs for {', '.join(pods)} (tail {args.tail}{', following' if args.follow else ''})", flush=True)
    for pod in pods:
        print(f"\n===== {pod} =====", flush=True)
        command = ["-n", NAMESPACE, "logs", pod, "--tail", str(args.tail)]
        if args.since:
            command += ["--since", args.since]
        if args.follow:
            command.append("-f")
        result = kubectl(*command, check=False, timeout=T_HURL if args.follow else 120)
        print(((result.stdout or "") + (result.stderr or "")).rstrip(), flush=True)
    return 0


def cmd_rebuild(args) -> int:
    service = args.service or APP_DEPLOYMENT
    if service != APP_DEPLOYMENT:
        raise Fail(f"unknown service {service!r}; this environment manages only {APP_DEPLOYMENT!r}")
    step("cluster")
    ensure_cluster()
    write_kubeconfig()
    wait_node_ready()
    check_disk()
    before = " ".join(pod_names(f"app={APP_DEPLOYMENT}"))
    step("image")
    tar, _ = build_image(force=True, skip_build=False)
    import_image(tar)
    step("rollout restart")
    restart_deployment(APP_DEPLOYMENT)
    step("host port-forward")
    ensure_forward("catalog-app", APP_PORT, "svc/catalog", 80, health_url=f"http://127.0.0.1:{APP_PORT}/actuator/health")
    step("health")
    wait_health()
    after = " ".join(pod_names(f"app={APP_DEPLOYMENT}"))
    ok(f"pod {before or '(none)'} → {after or '(none)'}")
    return 0


def cmd_restart(args) -> int:
    step("stop")
    cmd_stop(args)
    step("deploy")
    return cmd_deploy(args)


def cmd_stop(args) -> int:
    state = load_state()
    step("host port-forwards")
    stopped = stop_forwards(state)
    save_state(state)
    ok("; ".join(stopped) if stopped else "none running")

    step(f"cluster container {CLUSTER}")
    for name in (CLUSTER, *LEGACY_CLUSTERS):
        # `podman rm -f` exits 0 for a container that never existed, so ask first what is there.
        if not container_exists(name):
            ok(f"{name} was not running")
            continue
        podman("rm", "-f", name, timeout=120)
        ok(f"{name} removed")

    deadline = time.time() + 60
    while time.time() < deadline:
        if not any(container_exists(name) for name in (CLUSTER, *LEGACY_CLUSTERS)):
            break
        time.sleep(1)
    leftover = [name for name in (CLUSTER, *LEGACY_CLUSTERS) if container_exists(name)]
    if leftover:
        raise Fail(f"{', '.join(leftover)} still exists after podman rm -f")

    step("ports")
    freed, problems = free_ports((APP_PORT, KEYCLOAK_PORT, API_PORT))
    if freed:
        ok("; ".join(freed))
    if problems:
        raise Fail("; ".join(problems))
    ok(f"{', '.join(str(p) for p in (APP_PORT, KEYCLOAK_PORT, API_PORT))} free")

    state = empty_state()
    save_state(state)
    for stale in (KUBECONFIG, *LEGACY_KUBECONFIGS, RUNTIME / "catalog-tokens.env"):
        if stale.exists():
            stale.unlink()
            ok(f"removed {stale.relative_to(WORKSPACE)}")
    ok(f"state cleared ({STATE_FILE.relative_to(WORKSPACE)})")
    return 0


def cmd_auth(args) -> int:
    auth = mint_tokens() if not args.reuse else load_state().get("auth") or mint_tokens()
    print(f"realm {auth['realm']} via {auth['endpoint']}")
    print(f"{'user':<13}{'client':<28}{'scope':<40}{'expires'}")
    for user in USERS:
        entry = auth["tokens"][user]
        print(f"{user:<13}{entry['clientId']:<28}{entry['scope'][:38]:<40}{entry['expiresAt']} (+{entry['expiresIn']}s)")
    print()
    if args.json:
        print(json.dumps(auth, indent=2))
    else:
        for user in USERS:
            print(f"export {user.upper()}_TOKEN='{auth['tokens'][user]['token']}'")
        print(f"\nexports also on disk: {(RUNTIME / 'catalog-tokens.env').relative_to(WORKSPACE)}")
    return 0


def cmd_test(args) -> int:
    auth = load_state().get("auth")
    if not tokens_valid(auth):
        step("tokens")
        auth = mint_tokens()
    else:
        ok("tokens reused (still valid)")

    now = datetime.now(timezone.utc).replace(microsecond=0)
    today = now.date()
    variables = [
        ("BASE_URL", args.base_url),
        ("availability_future", (today + timedelta(days=30)).isoformat()),
        ("availability_past", (today - timedelta(days=30)).isoformat()),
        ("price_from_future", (now + timedelta(days=30)).isoformat().replace("+00:00", "Z")),
        ("price_until_future", (now + timedelta(days=60)).isoformat().replace("+00:00", "Z")),
        ("author_token", auth["tokens"]["author"]["token"]),
        ("reviewer_token", auth["tokens"]["reviewer"]["token"]),
        ("photographer_token", auth["tokens"]["photographer"]["token"]),
        ("sales_token", auth["tokens"]["sales"]["token"]),
    ]
    suite = Path(args.suite)
    if not suite.is_absolute():
        suite = SERVICE / suite
    if not suite.exists():
        raise Fail(f"suite not found: {suite}")

    command = ["hurl", "--test", "--max-time", "30"]
    for name, value in variables:
        command += ["--variable", f"{name}={value}"]
    command.append(str(suite))

    step(f"hurl --test {suite.relative_to(SERVICE)} against {args.base_url}")
    completed = run(command, cwd=SERVICE, timeout=T_HURL, check=False)
    output = (completed.stdout or "") + (completed.stderr or "")
    print(output.rstrip(), flush=True)
    requests = re.search(r"Executed requests:\s*(\d+)", output) or re.search(r"Requests:\s*(\d+)", output)
    files = re.search(r"Executed files:\s*(\d+)", output)
    print(f"\nexit code {completed.returncode}; "
          f"requests {requests.group(1) if requests else '?'}; "
          f"files {files.group(1) if files else '?'}")
    return completed.returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="run-apps", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)

    deploy = commands.add_parser("deploy", help="create/reuse the cluster, install infra, build, import, roll out")
    deploy.add_argument("--force-build", action="store_true", help="rebuild the image even when nothing changed")
    deploy.add_argument("--skip-build", action="store_true", help="reuse build/jib-image.tar without running Gradle")
    deploy.set_defaults(handler=cmd_deploy)

    status = commands.add_parser("status", help="cluster, pods, endpoints, health and host bridges")
    status.add_argument("--json", action="store_true")
    status.set_defaults(handler=cmd_status)

    logs = commands.add_parser("logs", help="bounded logs of one pod or of the app pods")
    logs.add_argument("pod", nargs="?", help="pod name; omit for every app pod")
    logs.add_argument("--tail", type=int, default=200)
    logs.add_argument("--since", default=None, help="kubectl --since, e.g. 10m")
    logs.add_argument("--follow", action="store_true", help="stream (Ctrl-C to stop) — opt-in only")
    logs.add_argument("--infra", action="store_true", help="with no pod argument, show the infra pods")
    logs.set_defaults(handler=cmd_logs)

    rebuild = commands.add_parser("rebuild", help="jibBuildTar → import → rollout restart → wait Ready")
    rebuild.add_argument("service", nargs="?", default=APP_DEPLOYMENT)
    rebuild.set_defaults(handler=cmd_rebuild)

    restart = commands.add_parser("restart", help="stop then deploy")
    restart.add_argument("--skip-build", action="store_true")
    restart.add_argument("--force-build", action="store_true")
    restart.set_defaults(handler=cmd_restart)

    stop = commands.add_parser("stop", help="delete the cluster, kill port-forwards, free the ports")
    stop.set_defaults(handler=cmd_stop)

    auth = commands.add_parser("auth", help="mint the four scoped tokens from the in-cluster Keycloak")
    auth.add_argument("--json", action="store_true")
    auth.add_argument("--reuse", action="store_true", help="keep the tokens on disk when they are still valid")
    auth.set_defaults(handler=cmd_auth)

    test = commands.add_parser("test", help="run the element-12 hurl contract against the cluster")
    test.add_argument("suite", nargs="?", default=str(APP_SUITE))
    test.add_argument("--base-url", default=f"http://127.0.0.1:{APP_PORT}")
    test.set_defaults(handler=cmd_test)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args)
    except Fail as failure:
        print(f"error: {failure}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
