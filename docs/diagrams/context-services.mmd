flowchart LR
  author(["Content author, content reviewer"])
  warehouse(["Warehouse employee"])

  subgraph repo["E-commerce platform"]
    fulfillment["fulfillment<br/>order intake, processing,<br/>parcels and read models"]
    catalog["catalog<br/>offers, pricing, review"]
  end

  subgraph external["External systems"]
    keycloak["Keycloak<br/>OIDC issuer, realm iot"]
    postgres["PostgreSQL<br/>Liquibase schema"]
    kafka["Kafka<br/>catalog.offer.events.v1"]
    inventree["InvenTree<br/>warehouse stock"]
    carrier["Carrier<br/>registration and label"]
    crm["CRM<br/>customer master"]
  end

  shopping["Shopping<br/>other service"]

  author --> catalog
  warehouse --> fulfillment
  catalog --> keycloak
  fulfillment --> keycloak
  catalog --> postgres
  fulfillment --> postgres
  catalog --> kafka
  kafka -- "OfferPublished, PricesChanged, ProductRemoved" --> shopping
  fulfillment --> inventree
  fulfillment --> carrier
  fulfillment -. "not integrated, out of scope" .- crm
