{
  "name": "storybook-basket",
  "private": true,
  "version": "0.0.0",
  "description": "Isolated low-fi gallery for the basket spec view 01 (this spec has no frontend; the prototype is a specification artifact)",
  "scripts": {
    "storybook": "storybook dev --config-dir . -p 6012 --host 127.0.0.1",
    "build-storybook": "storybook build --config-dir .",
    "verify": "node verify-storybook.frames.cjs http://localhost:6012 --flow flows.json",
    "shots": "node shoot.cjs"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/html-webpack5": "8.6.14",
    "playwright": "1.65.1",
    "storybook": "8.6.19"
  }
}
