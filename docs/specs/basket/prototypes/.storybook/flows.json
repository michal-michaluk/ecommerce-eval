{
  "flows": [
    {
      "name": "two items -> remove selected -> empty",
      "start": "basket-two-items--default",
      "steps": [{ "click": "#remove-selected", "expect": "basket-two-items-removed" }]
    },
    {
      "name": "empty -> continue shopping -> two items",
      "start": "basket-empty--default",
      "steps": [{ "click": "#continue-shopping", "expect": "basket-two-items--default" }]
    },
    {
      "name": "two items -> uncheck item 2 -> partial selection",
      "start": "basket-two-items--default",
      "steps": [{ "click": "#toggle-item-2", "expect": "basket-partial-selection--default" }]
    },
    {
      "name": "partial -> select whole basket -> two items",
      "start": "basket-partial-selection--default",
      "steps": [{ "click": "#toggle-all", "expect": "basket-two-items--default" }]
    },
    {
      "name": "out of stock -> unavailable (prototype state switch)",
      "start": "basket-out-of-stock--default",
      "steps": [{ "click": "#proto-unavailable", "expect": "basket-unavailable--default" }]
    },
    {
      "name": "blocked view reachable from the estimate view (prototype state switch)",
      "start": "basket-delivery-estimate--default",
      "steps": [{ "click": "#proto-blocked", "expect": "basket-blocked--default" }]
    }
  ]
}
