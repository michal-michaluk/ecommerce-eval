{
  "realm": "shopping",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 3600,
  "clientScopes": [
    {
      "name": "basic",
      "description": "Keycloak's standard basic claims; the resource server reads `sub` as the caller's identity",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "customer",
      "description": "Element 07 (D27): owns baskets, edits items, selects rows, hands the basket over to checkout",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "shopping-service",
      "description": "A service identity of this realm: a token that is valid here and is not a customer, so a customer route can answer 403 to it (DoD16)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "customer-client",
      "description": "The customer's own client: the only client whose token carries the `customer` scope",
      "enabled": true,
      "publicClient": false,
      "secret": "secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "defaultClientScopes": [
        "basic",
        "customer"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "shopping-service-client",
      "description": "The mirror of the customer client for the service identity: the same realm, the same grants, and no `customer` scope",
      "enabled": true,
      "publicClient": false,
      "secret": "secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "defaultClientScopes": [
        "basic",
        "shopping-service"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "customer",
      "enabled": true,
      "email": "customer@test.com",
      "emailVerified": true,
      "firstName": "Celina",
      "lastName": "Klient",
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shopping"
      ]
    },
    {
      "username": "service",
      "enabled": true,
      "email": "service@test.com",
      "emailVerified": true,
      "firstName": "Serwis",
      "lastName": "Sklepu",
      "credentials": [
        {
          "type": "password",
          "value": "service",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shopping"
      ]
    }
  ]
}
