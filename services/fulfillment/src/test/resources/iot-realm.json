  "clientScopes": [
    {
      "name": "basic",
      "description": "Keycloak's standard basic claims; the resource server reads `sub` as the caller's identity",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "fulfillment-employee",
      "description": "element 11: lists and claims orders, picks, packs, marks ready, reports issues, resumes a hold, prints both documents",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "fulfillment-resolver",
      "description": "element 11: reads the issue dashboard and resumes a hold",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "fulfillment-customer",
      "description": "element 11: reads one order processing state",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "shopping-service",
      "description": "element 11: hands a finished order over on POST /orders",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
